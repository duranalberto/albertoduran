{
  "name": "albertoduran",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "./"
  },
  "runArgs": ["--network=host", "--dns=8.8.8.8", "--dns-search=."],
  "remoteUser": "node",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.localPortHost": "allInterfaces",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/usr/bin/zsh" }
        },
        "editor.fontFamily": "'Fira Code', 'FiraCode Nerd Font', Consolas, 'Courier New', monospace",
        "editor.fontLigatures": true,
        "terminal.integrated.fontFamily": "'FiraCode Nerd Font'"
      },
      "extensions": [
        "pkief.material-icon-theme",
        "dunstontc.monokai-plusplus",
        "astro-build.astro-vscode",
        "unifiedjs.vscode-mdx",
        "dsznajder.es7-react-js-snippets",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "davidanson.vscode-markdownlint",
        "schmidsi.better-git-line-blame",
        "mhutchie.git-graph",
        "Fuzionix.file-tree-extractor"
      ]
    }
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro Preview",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  }
}

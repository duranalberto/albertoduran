{
  "name": "albertoduran",
  "type": "module",
  "version": "0.5.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "build": "astro build",
    "postbuild": "node scripts/check-build-output.mjs",
    "build:test": "ALBERTODURAN_TEST_MODE=true MERMAID_RENDERER_FIXTURE=true astro build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc -p tests/e2e/tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:test && npm run check:bundle && playwright test --grep-invert @visual",
    "test:visual": "npm run build:test && playwright test --grep @visual",
    "test:visual:update": "npm run build:test && playwright test --grep @visual --update-snapshots",
    "test:watch": "vitest",
    "font:subset": "node scripts/subset-fira-code.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "7.4.2",
    "bloomwright-mdx": "git+https://github.com/duranalberto/bloomwright-mdx.git",
    "bloomwright-ui": "git+https://github.com/duranalberto/bloomwright-ui.git",
    "daisyui": "^5.7.50",
    "echarts": "6.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.1.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "satteri": "^0.10.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "bloomwright-mdx": {
      "@astrojs/markdown-satteri": "$@astrojs/markdown-satteri",
      "@astrojs/mdx": "$@astrojs/mdx",
      "satteri": "$satteri"
    }
  }
}

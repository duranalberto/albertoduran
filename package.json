    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "astro": "^7.0.3",
    "daisyui": "^5.5.23",

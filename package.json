{
  "name": "albertoduran",
  "type": "module",
  "version": "0.4.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "build": "astro build",
    "build:test": "ALBERTODURAN_TEST_MODE=true MERMAID_RENDERER_FIXTURE=true astro build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:test && npm run check:bundle && node tests/e2e/run-preview-tests.mjs",
    "test:watch": "vitest",
    "font:subset": "node scripts/subset-fira-code.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.4",
    "@astrojs/mdx": "^7.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^7.2.2",
    "bloomwright-mdx": "git+https://github.com/duranalberto/bloomwright-mdx.git",
    "bloomwright-ui": "git+https://github.com/duranalberto/bloomwright-ui.git",
    "daisyui": "^5.7.17",
    "echarts": "6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.11.0",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.6",
    "satteri": "^0.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }

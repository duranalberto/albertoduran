    "hast-util-to-html": "^9.0.5",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "satteri": "^0.9.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",

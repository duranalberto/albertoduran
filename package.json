{
  "name": "albertoduran",
  "type": "module",
  "version": "0.2.10",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:test": "ALBERTODURAN_TEST_MODE=true MERMAID_RENDERER_FIXTURE=true astro build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:test && npm run check:bundle && node tests/e2e/run-preview-tests.mjs",
    "test:watch": "vitest"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/csso": "^5.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.1",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "astro": "^6.4.4",
    "csso": "^5.0.5",
    "daisyui": "^5.5.20",
    "echarts": "6.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.6.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.8"
  }

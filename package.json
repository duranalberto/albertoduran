    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:test && npm run check:bundle && node tests/e2e/run-preview-tests.mjs",
    "test:watch": "vitest",
    "font:subset": "node scripts/subset-fira-code.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-satteri": "^0.3.2",

---
import {
  type CurrentSite,
  isTheJourneyPublication,
  type Sites,
  sitesManifest,
} from "@appTypes/navigation";
import AlbertoDuran from "@components/ui/AlbertoDuran.astro";
import SVGIcon from "@components/ui/SVGIcon.astro";
import VaultTreeNode from "@components/ui/VaultTreeNode.astro";
import { ui } from "@data/icons";
import { getContextFromPath } from "@utils/thejournal_manifest";

interface Props {
  navSites: Sites[];
  currentSite: CurrentSite;
}

const { navSites, currentSite } = Astro.props;

const isPublication = isTheJourneyPublication(currentSite);
const [entryContext, vaultContext] = isPublication
  ? getContextFromPath(currentSite.path)
  : [null, null];

const getDrawerLinkClasses = (site: Sites) => {
  const isActive = site === currentSite.site;
  return [
    "block select-none py-4 px-6 font-display transition-all duration-200 ease-in-out",
    isActive
      ? "font-bold text-primary bg-primary/10 border-r-4 border-primary"
      : "text-base-content/80 border-r-4 border-transparent hover:text-base-content md:hover:bg-base-200/50 md:hover:border-primary/30 active:bg-base-300/70",
  ].join(" ");
};

const visibilityClasses = isPublication ? "xl:hidden" : "lg:hidden";
---

<div class="drawer-side z-60 overscroll-contain">
  <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"
  ></label>

  <div
    class="menu min-h-dvh w-80 bg-base-100 p-0 font-sans text-base-content border-r border-base-content/5 shadow-xl"
  >
    <div
      class={`flex items-center gap-4 px-4 py-4 md:px-8 mb-6 ${visibilityClasses}`}
    >
      <div class="flex-none">
        <label
          for="main-drawer"
          class="btn btn-square btn-ghost focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span class="sr-only">Close Navigation Menu</span>
          <SVGIcon icon={ui.menu} stroke="currentColor" strokeWidth={2} />
        </label>
      </div>

      <AlbertoDuran />
    </div>

    <div class="lg:hidden">
      <nav aria-label="Mobile Navigation">
        <ul class="flex flex-col">
          {
            navSites.map((site) => (
              <li>
                <a
                  href={site}
                  class={getDrawerLinkClasses(site)}
                  data-astro-prefetch="viewport"
                  style="touch-action: manipulation;"
                >
                  {sitesManifest[site].label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {
      isPublication && vaultContext && entryContext && (
        <>
          <div class="divider my-8 px-6 opacity-10 lg:hidden" />
          <div class="mb-8 xl:hidden">
            <h3 class="mb-6 px-6 font-display text-xs font-bold tracking-widest uppercase">
              Table of Contents
            </h3>
            <ul class="flex flex-col">
              {[vaultContext.index, ...vaultContext.items].map((item) => (
                <li class="transition-colors active:bg-base-200/50">
                  <VaultTreeNode
                    item={item}
                    currentEntryId={entryContext.id}
                    level={0}
                    classNames="px-6"
                  />
                </li>
              ))}
            </ul>
          </div>
        </>
      )
    }
  </div>
</div>

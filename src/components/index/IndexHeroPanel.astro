---
/**
 * IndexHeroPanel.astro
 *
 * Personal "Live Feed + Interests" right-side column for IndexHero. It sits
 * in the hero like the text column does (eyebrow, line icons, display type)
 * instead of as a separate card.
 */
import { ui } from "@data/icons";
import SVGIcon from "bloomwright-ui/components/primitive/SVGIcon.astro";

interface CurrentItem {
  icon: string;
  label: string;
  values: string[];
}

interface InterestTile {
  icon: string;
  label: string;
  detail: string;
}

const currentItems: CurrentItem[] = [
  {
    icon: "feedBuilding",
    label: "Building",
    values: [
      "Ravnary.com",
      "AWS Lambda pipelines",
      "LangGraph agents workflows",
    ],
  },
  {
    icon: "feedPlaying",
    label: "Playing",
    values: ["Splatoon 3", "Pokopia"],
  },
  {
    icon: "feedWatching",
    label: "Watching",
    values: ["Lanterns", "Rick and Morty"],
  },
  /*{ icon: "feedWatching", label: "Watched", values: ["Super Mario Galaxy"] },
  { icon: "…", label: "Listening", values: ["31 Minutos"] },*/
];

const interests: InterestTile[] = [
  { icon: "atlas", label: "Atlas FC", detail: "Even if they win" },
  { icon: "feedPlaying", label: "Gaming", detail: "Zelda · Pokémon · Fire Emblem" },
  { icon: "interestSeries", label: "TV Series", detail: "GoT · HotD · AKOTSK" },
  { icon: "interestSports", label: "Sports", detail: "Football · Volleyball · Padel" },
  { icon: "interestDrinks", label: "Drinks", detail: "Cofee · Tea" },
  { icon: "interestFood", label: "Food", detail: "Tacos · Chilaquiles" },
];
---

<aside class="hero-panel" aria-label="Personal snapshot">
  <section aria-labelledby="hero-panel-feed">
    <h2 id="hero-panel-feed" class="hero-panel-eyebrow">
      <span class="hero-panel-pulse" aria-hidden="true"></span>
      Live Feed
    </h2>

    <ul class="hero-panel-status-list" role="list">
      {
        currentItems.map((item, i) => {
          const icon = ui[item.icon];

          return (
            <li class="hero-panel-status-item" style={`--item-index: ${i};`}>
              <span class="hero-panel-status-icon" aria-hidden="true">
                {icon && <SVGIcon icon={icon} label="" class="size-5" />}
              </span>
              <span class="hero-panel-status-label">{item.label}</span>
              <span class="hero-panel-status-value">
                {item.values.join(" · ")}
              </span>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-labelledby="hero-panel-interests">
    <h2 id="hero-panel-interests" class="hero-panel-eyebrow">
      A few things I care about
    </h2>

    <ul class="hero-panel-grid" role="list">
      {
        interests.map((tile, i) => {
          const icon = ui[tile.icon];

          return (
            <li class="hero-panel-tile" style={`--tile-index: ${i};`}>
              <span class="hero-panel-tile-head">
                {icon && (
                  <SVGIcon
                    icon={icon}
                    label=""
                    class="hero-panel-tile-icon size-5"
                  />
                )}
                <span class="hero-panel-tile-label">{tile.label}</span>
              </span>
              <span class="hero-panel-tile-detail">{tile.detail}</span>
            </li>
          );
        })
      }
    </ul>
  </section>
</aside>

---
import type ProfessionalMetric from "@appTypes/profile_view";
import GlassPanel from "@components/ui/primitive/GlassPanel.astro";
import StripBackground from "@components/ui/display/StripBackground.astro";
import Button from "@components/ui/primitive/Button.astro";
import ParallaxHero from "@layouts/ParallaxHero.astro";

const metrics: ProfessionalMetric[] = [
  {
    label: "Experience",
    highlights: ["6+ Years"],
    details: ["Oracle", "TCS USAA"],
  },
  {
    label: "Core Stack",
    highlights: ["Python", "Java", "JavaScript"],
    details: ["React", "FastAPI", "Oracle JET"],
  },
  {
    label: "Professional Interest",
    highlights: ["Software Architecture"],
    details: ["Distributed Systems", "System Design", "Scalability"],
  },
];
---

<ParallaxHero>
  <StripBackground slot="background" />

  <div
    class="flex flex-col lg:flex-row items-stretch justify-center gap-8 lg:gap-10 max-w-7xl mx-auto px-4 w-full"
  >
    <GlassPanel
      class="p-8 md:p-10 w-full lg:w-[35%] flex items-center"
    >
      <div class="flex flex-col gap-6 text-center lg:text-left w-full">
        <h2 class="text-xl sm:text-3xl md:text-4xl text-primary uppercase">
          My Professional Profile
        </h2>
        <p
          class="text-sm sm:text-base md:text-lg leading-relaxed text-base-content/90"
        >
          I am a Software Engineer with hands-on experience in both backend and
          frontend development. I am driven by a lifelong goal to become a
          Software Architect dedicated to solve complex problems at scale.
        </p>
      </div>
    </GlassPanel>

    <div class="w-full lg:w-[65%] flex flex-col">
      <GlassPanel class="flex flex-col md:flex-row w-full h-full">
        {
          metrics.map((metric, index) => (
            <div
              class:list={[
                "metric-card flex-1 flex flex-col items-center justify-center text-center p-8 min-w-0 transition-transform duration-300 hover:scale-[1.03]",
                index !== 0
                  ? "border-t md:border-t-0 md:border-l border-base-content/10"
                  : "",
              ]}
            >
              <span class="text-xs uppercase tracking-widest font-bold opacity-60 mb-2">
                {metric.label}
              </span>

              <span class="text-2xl font-black text-primary leading-tight tracking-tight">
                {metric.highlights.map((text, i) => (
                  <>
                    {text}
                    {i < metric.highlights.length - 1 && (
                      <>
                        <br class="hidden md:block" />
                        <span class="md:hidden"> • </span>
                      </>
                    )}
                  </>
                ))}
              </span>

              <div class="mt-3 flex flex-col items-center">
                <span class="text-sm font-medium opacity-80">
                  {metric.details.map((text, i) => (
                    <>
                      {text}
                      {i < metric.details.length - 1 && (
                        <>
                          <br class="hidden md:block" />
                          <span class="md:hidden opacity-40"> • </span>
                        </>
                      )}
                    </>
                  ))}
                </span>
              </div>
            </div>
          ))
        }
      </GlassPanel>

      <div class="mt-8 lg:mt-10">
        <GlassPanel interactive={false} class="p-6 md:p-8">
          <div
            class="flex flex-col sm:flex-row items-center justify-between gap-6"
          >
            <div class="text-center sm:text-left">
              <p class="text-base md:text-lg text-base-content/90">
                Discover my detailed experience, technical skills, and
                enterprise contributions.
              </p>
            </div>

            <Button
              href="/profile/"
              label="View Professional Profile"
              variant="btn-primary"
              size="btn-lg"
              ariaLabel="View detailed professional profile"
              class="min-w-60 shadow-lg hover:scale-105 active:scale-95 transition-transform"
            />
          </div>
        </GlassPanel>
      </div>
    </div>
  </div>
</ParallaxHero>

---
import type { BuiltWith, SocialLink } from "@appTypes/footer";
import AlbertoDuran from "@components/ui/primitive/AlbertoDuran.astro";
import SVGIcon from "@components/ui/primitive/SVGIcon.astro";
import { social } from "@data/icons";

const builtWith: BuiltWith[] = [
  { label: "Astro.js", href: "https://astro.build" },
  { label: "DaisyUI", href: "https://daisyui.com" },
];

const socialLinks: SocialLink[] = [
  {
    label: "LinkedIn Profile",
    href: "https://www.linkedin.com/in/duranalberto/",
    icon: social.linked_in,
    display: "in/duranalberto",
  },
  {
    label: "GitHub Profile",
    href: "https://github.com/duranalberto",
    icon: social.github,
    display: "@duranalberto",
  },
];
---

<footer
  class="border-t border-base-300 bg-base-200 font-sans text-base-content"
>
  <div
    class="footer md:footer-horizontal mx-auto max-w-screen-2xl p-10 md:px-8"
  >
    <aside>
      <AlbertoDuran />
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-base-content/70">
        Software Engineer. Always learning.
      </p>
    </aside>

    <nav>
      <h6 class="footer-title text-primary opacity-100">Built With</h6>
      {
        builtWith.map((tech) => (
          <a
            href={tech.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover text-sm text-base-content/70 transition-colors duration-200 hover:text-primary"
          >
            {tech.label}
          </a>
        ))
      }
      <a
        href="https://workers.cloudflare.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 text-xs italic text-base-content/40 transition-opacity hover:opacity-100"
      >
        Hosted by Cloudflare Workers
      </a>
    </nav>

    <nav>
      <h6 class="footer-title text-primary opacity-100">Social Presence</h6>
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover group flex items-center gap-2 text-sm text-base-content/70 transition-colors duration-200 hover:text-primary"
            aria-label={link.label}
          >
            <SVGIcon icon={link.icon} width={18} height={18} />
            <span class="pl-2">{link.display}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div
    class="mx-auto max-w-screen-2xl border-t border-base-300 px-10 py-6 md:px-8"
  >
    <div
      class="flex flex-col items-center justify-between gap-4 text-xs md:flex-row"
    >
      <p class="text-base-content/60">
        © {new Date().getFullYear()} Alberto Duran
      </p>

      <div class="text-base-content/40 italic">
        Designed with ❤️ and a questionable amount of sleep deprivation
      </div>
    </div>
  </div>
</footer>

---
import {
  type CurrentSite,
  getCurrentSite,
  type Sites,
} from "@appTypes/navigation";
import ThemeToggle from "@components/ui/navigation/ThemeToggle.astro";
import AlbertoDuran from "@components/ui/primitive/AlbertoDuran.astro";
import SVGIcon from "bloomwright-ui/components/primitive/SVGIcon.astro";
import { ui } from "@data/icons";
import { sitesManifest } from "@data/site_manifest";

const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;

const navSites: Sites[] = ["/profile/", "/projects/", "/thejournal/"];
const currentSite: CurrentSite = getCurrentSite(normalizedPath);
const menuIcon = ui.menu;

if (!menuIcon) {
  throw new Error("The 'menu' icon is missing from the ui data manifest.");
}
---

<header
  class="sticky top-0 z-50 w-full bg-base-100/90 backdrop-blur-md will-change-transform"
>
  <div class="navbar w-full max-w-screen-2xl px-4 py-2 mx-auto md:px-8">
    <div class="navbar-start">
      <div class="dropdown lg:hidden">
        <div
          tabindex="0"
          role="button"
          class="btn btn-square btn-ghost focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary touch-manipulation"
          aria-label="Open Navigation Menu"
        >
          <SVGIcon icon={menuIcon} stroke="currentColor" strokeWidth={2} />
        </div>
        <ul
          tabindex="0"
          class="menu menu-md dropdown-content mt-1 z-1 w-52 p-2 shadow-lg rounded-box bg-base-100 border border-base-200"
        >
          {
            navSites.map((site) => {
              const isActive = site === currentSite.site;
              return (
                <li>
                  <a
                    href={site}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "block py-3 font-display text-base touch-manipulation nav-link-hover",
                      isActive
                        ? "font-bold text-primary bg-primary/10"
                        : "text-base-content/80",
                    ]}
                    data-astro-prefetch
                  >
                    {sitesManifest[site].label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="hidden lg:flex">
        <AlbertoDuran />
      </div>
    </div>

    <div class="navbar-center">
      <div class="lg:hidden">
        <AlbertoDuran />
      </div>

      <nav class="hidden lg:flex" aria-label="Main Navigation">
        <ul class="flex gap-10">
          {
            navSites.map((site) => {
              const isActive = site === currentSite.site;

              return (
                <li class="group relative">
                  <a
                    href={site}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "relative block w-full px-1 py-3 font-display text-sm tracking-wide md:text-base rounded-sm focus-visible:ring-2 focus-visible:ring-primary outline-none touch-manipulation nav-link-hover",
                      isActive ? "text-base-content" : "text-base-content/70",
                    ]}
                    data-astro-prefetch
                  >
                    {sitesManifest[site].label}

                    {isActive && (
                      <span
                        class="header-active-line absolute bottom-1 left-0 w-full h-0.5 bg-primary scale-x-100"
                      />
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <div class="navbar-end gap-4">
      <ThemeToggle />
    </div>
  </div>
</header>

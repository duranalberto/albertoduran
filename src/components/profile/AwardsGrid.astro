---
import { type Awards } from "@appTypes/about";
import ArrowLink from "@components/ui/navigation/ArrowLink.astro";

interface Props {
  awards: Awards[];
}

const { awards } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
  {
    awards.map((award) => (
      <div class="card card-border bg-base-200 text-base-content rounded-box shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-xl flex flex-col items-start p-6 will-change-transform">
        <h3 class="font-display text-xl font-semibold leading-tight">
          {award.title}
        </h3>

        <p class="mt-1 text-sm font-bold tracking-[0.22em] uppercase text-neutral-content opacity-90">
          {award.org}
        </p>

        <p class="mt-3 text-lg leading-7 text-neutral-content opacity-90">
          {award.desc}
        </p>

        {award.link && (
          <ArrowLink
            href={award.link}
            variant="action"
            external
            class="mt-auto pt-4"
          >
            View award
          </ArrowLink>
        )}
      </div>
    ))
  }
</div>

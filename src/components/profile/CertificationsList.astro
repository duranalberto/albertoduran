---
import { type Certifications } from "@appTypes/about";
import ArrowLink from "@components/ui/navigation/ArrowLink.astro";

interface Props {
  certifications: Certifications[];
}

const { certifications } = Astro.props;
---

<ul class="flex flex-col gap-8">
  {
    certifications.map((cert) => (
      <li class="flex flex-col gap-2">
        <h3 class="font-display text-xl font-semibold leading-tight text-base-content">
          {cert.name}
        </h3>

        <ArrowLink href={cert.link} variant="action" external>
          View credential
        </ArrowLink>
      </li>
    ))
  }
</ul>

---
import type { Education } from "@appTypes/about";

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<div class="flex flex-col gap-8">
  {
    education.map((edu) => (
      <div class="flex flex-col gap-2">
        <h3 class="font-display text-xl font-semibold leading-tight text-base-content">
          {edu.school}
        </h3>

        <p class="text-lg leading-relaxed text-neutral-content opacity-90">
          {edu.degree}
        </p>
        <p class="mt-1 text-sm font-medium tracking-wide text-primary">
          {edu.period}
        </p>
      </div>
    ))
  }
</div>

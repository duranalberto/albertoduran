---
import SocialTire from "@components/ui/primitive/SocialTire.astro";

const props = Astro.props;
---

<section class="hero-section relative overflow-hidden font-sans" {...props}>
  <div class="hero-shell">
    <div class="hero-grid">
      <div class="hero-primary xl:col-span-7">
        <div class="hero-eyebrow" aria-hidden="true">
          <span class="hero-eyebrow-line"></span>
          <p class="hero-eyebrow-label">Technical Roadmap</p>
        </div>

        <h1
          class="hero-heading font-display text-4xl sm:text-5xl md:text-6xl xl:text-8xl select-none mb-8"
        >
          <span class="text-primary">Alberto</span>
          <span class="text-base-content">Duran</span><br />
          <span class="inline-block whitespace-nowrap">
            <span class="text-primary">Software</span>
            <span class="text-base-content">Engineer</span>
          </span>
        </h1>

        <p class="hero-description text-lg leading-relaxed text-neutral-content md:text-xl mb-8">
          Results-oriented Software Engineer with experience designing,
          optimizing, and deploying web applications and enterprise solutions.
          Analytical and delivery-focused, with an emphasis on scalable,
          maintainable systems that support business and user needs.
        </p>

        <SocialTire />
      </div>

      <div class="flex min-w-0 flex-col justify-end xl:items-end xl:col-span-5">
        <div class="flex flex-col xl:text-right">
          <span
            class="select-none font-display text-8xl font-black leading-none text-primary/15 md:text-9xl xl:text-[10rem]"
          >
            06+
          </span>
          <span
            class="xl:mr-2 -mt-4 text-sm font-bold uppercase tracking-[0.2em] text-neutral-content opacity-90"
          >
            Years Experience
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

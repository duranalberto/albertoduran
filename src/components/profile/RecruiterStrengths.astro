---
import type { Strength } from "@appTypes/about";

interface Props {
  strengths: Strength[];
}

const { strengths } = Astro.props;
---

<div class="flex flex-col gap-6">
  <p class="max-w-4xl text-lg leading-8 text-neutral-content opacity-90">
    Best fit for web platform, internal tools, full-stack, application
    modernization, and backend-facing engineering roles where maintainability,
    reliability, automation, and product-facing delivery matter.
  </p>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      strengths.map((strength) => (
        <article class="card card-border bg-base-200 text-base-content rounded-box shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-xl flex h-full flex-col p-6 will-change-transform">
          <h3 class="font-display text-lg font-semibold leading-tight text-base-content">
            {strength.title}
          </h3>

          <p class="mt-3 text-base leading-7 text-neutral-content opacity-90">
            {strength.description}
          </p>
        </article>
      ))
    }
  </div>
</div>

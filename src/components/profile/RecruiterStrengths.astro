---
import type { Strength } from "@appTypes/about";
import { ui } from "@data/icons";
import SVGIcon from "bloomwright-ui/components/primitive/SVGIcon.astro";

interface Props {
  strengths: Strength[];
}

const { strengths } = Astro.props;
const steps = strengths.filter((strength) => !strength.everyStep);
const constants = strengths.filter((strength) => strength.everyStep);
---

<div class="flex flex-col gap-10" data-strengths>
  <p class="max-w-4xl text-lg leading-8 text-neutral-content opacity-90">
    These are the habits I bring to professional work and personal projects.
  </p>

  <ol
    class="strengths-path relative grid grid-cols-1 gap-8 lg:gap-0"
    style={`--steps: ${steps.length}`}
    aria-label="Habits, in the order the work moves through them"
  >
    {
      steps.map((strength, index) => {
        const icon = ui[strength.icon];

        return (
          <li class="relative flex flex-col gap-3 pl-16 lg:pl-0 lg:pr-6 lg:pt-20">
            <span class="absolute left-0 top-0 z-[1] grid size-12 place-items-center rounded-full border-2 border-primary bg-base-100 text-primary">
              <SVGIcon icon={icon} label="" class="size-6" />
            </span>
            <span class="font-mono text-xs font-medium text-primary" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="font-display text-lg font-semibold leading-tight text-base-content">
              {strength.title}
            </h3>
            {strength.takeaway && (
              <p class="font-medium leading-7 text-base-content">
                {strength.takeaway}
              </p>
            )}
            <p class="text-sm leading-6 text-base-content/70">
              {strength.context}
            </p>
          </li>
        );
      })
    }
  </ol>

  {
    constants.map((strength) => {
      const icon = ui[strength.icon];

      return (
        <div class="grid gap-3 rounded-box bg-base-200 p-6 md:grid-cols-[auto_1fr] md:items-center md:gap-8">
          <div class="flex items-center gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-primary/15 text-primary">
              <SVGIcon icon={icon} label="" class="size-6" />
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">
                At every step
              </p>
              <h3 class="font-display text-lg font-semibold leading-tight text-base-content">
                {strength.title}
              </h3>
            </div>
          </div>
          <p class="leading-7 text-base-content/75">{strength.context}</p>
        </div>
      );
    })
  }
</div>

<style>
  /* The connector: vertical down the icon column on small screens,
     horizontal through the icon row once the steps sit side by side. */
  .strengths-path::before {
    content: "";
    position: absolute;
    left: calc(1.5rem - 1px);
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    background: linear-gradient(
      var(--color-primary),
      color-mix(in srgb, var(--color-primary) 20%, transparent)
    );
  }

  @media (min-width: 1024px) {
    .strengths-path {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    }

    .strengths-path::before {
      left: 1.5rem;
      right: 1.5rem;
      top: calc(1.5rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--color-primary),
        color-mix(in srgb, var(--color-primary) 20%, transparent)
      );
    }
  }
</style>

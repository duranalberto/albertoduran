---
// Plain strings are text; one-item arrays are highlighted keywords. Keeping
// the spaces inside the strings stops whitespace collapsing next to <mark>.
type Segment = string | [string];

interface Stage {
  id: string;
  label: string;
  title: string;
  body: Segment[];
  current?: boolean;
}

const stages: Stage[] = [
  {
    id: "role-fit-evidence",
    label: "Today",
    title: "What I bring",
    body: [
      "I have worked with ",
      ["enterprise Java"],
      ", ",
      ["Python migration tools"],
      ", ",
      ["web platforms"],
      ", and ",
      ["production reliability"],
      " issues. My personal projects add ",
      ["AWS"],
      " serverless services, ",
      ["Next.js"],
      ", ",
      ["Astro"],
      ", ",
      ["FastAPI"],
      ", ",
      ["REST APIs"],
      ", ",
      ["authentication"],
      ", and ",
      ["data persistence"],
      ".",
    ],
  },
  {
    id: "role-fit-target",
    label: "Looking for",
    title: "Where I fit",
    current: true,
    body: [
      "I am looking for ",
      ["full-stack or backend-oriented"],
      " work. ",
      ["Internal tools"],
      ", ",
      ["web platforms"],
      ", ",
      ["application modernization"],
      ", and ",
      ["migration projects"],
      " are a particularly good match for my experience.",
    ],
  },
  {
    id: "role-fit-growth",
    label: "Next",
    title: "Where I want to grow",
    body: [
      "I want more responsibility for the ",
      ["services and data behind a product"],
      ". I also want to deepen my ",
      ["cloud and backend framework"],
      " experience.",
    ],
  },
];
---

<div
  class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-stretch"
  data-role-fit
>
  {
    stages.map((stage, index) => (
      <>
        {index > 0 && (
          <span
            class="hidden self-center text-2xl text-primary lg:block"
            aria-hidden="true"
          >
            →
          </span>
        )}
        <section
          class:list={[
            "flex flex-col gap-4 rounded-box p-6 sm:p-8",
            stage.current ? "role-fit-now" : "bg-base-200",
          ]}
          aria-labelledby={stage.id}
        >
          <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">
            {stage.label}
          </p>
          <h3
            id={stage.id}
            class="font-display text-xl font-semibold leading-tight"
          >
            {stage.title}
          </h3>
          <p class="leading-7 text-base-content/75">
            {stage.body.map((segment) =>
              typeof segment === "string" ? segment : <mark>{segment[0]}</mark>,
            )}
          </p>
        </section>
      </>
    ))
  }
</div>

<style>
  /* The target role stands out from the two cards around it. */
  .role-fit-now {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-base-200));
  }

  /* A low highlighter stroke, so keywords catch a skimming eye without
     turning the paragraph into a wall of bold. */
  mark {
    padding-inline: 0.1em;
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--color-primary) 22%, transparent) 58%
    );
    color: var(--color-base-content);
    font-weight: 600;
  }
</style>

---
import type { ProjectSummary } from "@data/projects";

interface Props {
  project: ProjectSummary;
  index: number;
}

const { project, index } = Astro.props;
const ordinal = String(index + 1).padStart(2, "0");
---

<a
  href={project.href}
  aria-label={`Explore the ${project.title} project`}
  data-project-card={project.href}
  class="group block h-full rounded-box outline-none transition-transform duration-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4 focus-visible:ring-offset-base-100 active:scale-[0.99]"
  data-astro-prefetch
>
  <article
    class="card card-border relative flex h-full overflow-hidden bg-base-200 text-base-content shadow-sm transition-[transform,box-shadow,border-color] duration-200 group-hover:-translate-y-1 group-hover:border-primary/40 group-hover:shadow-xl"
  >
    <span
      class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100 group-focus-visible:scale-x-100"
      aria-hidden="true"
    ></span>

    <div class="card-body gap-6 p-6 sm:p-8">
      <header class="space-y-5">
        <div class="flex items-start justify-between gap-4">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">
            {project.category}
          </p>
          <span
            class="font-mono text-sm font-bold tabular-nums text-base-content/35"
            aria-hidden="true"
            data-project-ordinal={ordinal}
          >
            {ordinal}
          </span>
        </div>
        <h3
          class="card-title break-words font-display text-3xl leading-tight transition-colors group-hover:text-primary sm:text-4xl"
        >
          {project.title}
        </h3>
      </header>

      <p class="text-base leading-relaxed text-base-content/75">
        {project.description}
      </p>

      <p
        class="border-l-2 border-primary/40 pl-4 text-sm leading-relaxed text-base-content/70"
        data-project-signal
      >
        {project.signal}
      </p>

      <ul
        class="flex flex-wrap gap-2"
        aria-label={`${project.title} technologies`}
      >
        {
          project.technologies.map((technology) => (
            <li class="badge badge-ghost border border-base-300 py-2 font-medium">
              {technology}
            </li>
          ))
        }
      </ul>

      <footer class="mt-auto flex items-center gap-4 border-t border-base-300 pt-5">
        <span
          class="inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-[0.12em] text-primary transition-[gap] group-hover:gap-4"
        >
          Explore project <span aria-hidden="true">&rarr;</span>
        </span>
        <span class="h-px grow bg-base-300" aria-hidden="true"></span>
      </footer>
    </div>
  </article>
</a>

---
import type { ResolvedProjectSummary } from "@content/project_stats";
import ProjectMedia from "@components/projects/ProjectMedia.astro";
import ProjectStat from "@components/projects/ProjectStat.astro";
import TechStack from "@components/projects/TechStack.astro";

interface Props {
  project: ResolvedProjectSummary;
  /** Wide cards take 7 of 12 columns on large screens, the others take 5. */
  wide: boolean;
}

const { project, wide } = Astro.props;
const title = project.shortTitle ?? project.title;
---

<article
  data-project-card={project.href}
  class:list={[
    "card card-border group relative min-w-0 overflow-hidden bg-base-200 text-base-content shadow-sm transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl focus-within:border-primary/40",
    wide ? "lg:col-span-7" : "lg:col-span-5",
  ]}
>
  <ProjectMedia
    title={project.title}
    media={project.media}
    variant="card"
    sizes={wide
      ? "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 58vw"
      : "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 42vw"}
    class="project-card-media border-b border-base-300"
  />

  <div class="card-body gap-3 p-5 sm:p-6 [&>p]:grow-0">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">
      {project.shortCategory ?? project.category}
    </p>

    <h3 class="card-title font-display text-2xl leading-tight transition-colors group-hover:text-primary sm:text-3xl">
      <a
        href={project.href}
        aria-label={`Explore the ${project.title} project`}
        class="outline-none after:absolute after:inset-0 after:z-[1] after:rounded-box focus-visible:after:ring-2 focus-visible:after:ring-inset focus-visible:after:ring-primary"
        data-astro-prefetch
      >
        {title}
      </a>
    </h3>

    <p class="leading-relaxed text-base-content/75">{project.tagline}</p>

    <ProjectStat stat={project.stat} />

    <footer class="mt-auto flex flex-wrap items-end gap-4 border-t border-base-300 pt-4">
      <TechStack
        stack={project.stack}
        label={`${project.title} stack`}
        class="min-w-0 flex-[1_1_16rem]"
      />
      <span
        class="ml-auto inline-flex h-9 shrink-0 items-center gap-2 font-display text-sm font-bold uppercase tracking-[0.12em] text-primary transition-[gap] group-hover:gap-4"
        aria-hidden="true"
      >
        Explore <span>&rarr;</span>
      </span>
    </footer>
  </div>
</article>


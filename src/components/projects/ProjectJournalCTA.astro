---
import OutlineActionButton from "@components/ui/primitive/OutlineActionButton.astro";
import { ui } from "@data/icons";

interface Props {
  href: string;
  projectTitle: string;
}

const { href, projectTitle } = Astro.props;
const journalIcon = ui.vault;
---

<OutlineActionButton
  href={href}
  icon={journalIcon}
  label="Technical details"
  size="btn-md"
  ariaLabel={`See how ${projectTitle} works in The Journal`}
/>

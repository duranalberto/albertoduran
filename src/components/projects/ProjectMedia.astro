---
import type { ProjectSlide } from "@data/projects";
import ProjectVisual from "@components/projects/ProjectVisual.astro";
import { Picture } from "astro:assets";

interface Props {
  title: string;
  media: readonly ProjectSlide[];
  /** `card` overlays compact controls and cycles on hover; `showcase` adds a browser frame, arrows and a caption. */
  variant: "card" | "showcase";
  address?: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}

const {
  title,
  media,
  variant,
  address,
  sizes,
  eager = false,
  class: className,
} = Astro.props;
const count = media.length;
const hasControls = count > 1;
const isShowcase = variant === "showcase";
const first = media[0];
---

<project-media
  class:list={["project-media block min-w-0", `project-media--${variant}`, className]}
  data-autocycle={variant === "card" ? "" : undefined}
  role="group"
  aria-roledescription="carousel"
  aria-label={`${title} screenshots`}
>
  <div class:list={[isShowcase && "mockup-browser project-media-browser border border-base-300 bg-base-300 shadow-xl"]}>
    {
      isShowcase && (
        <div class="mockup-browser-toolbar">
          <div class="input project-media-address">{address}</div>
        </div>
      )
    }

    <div class="project-media-stage" data-media-stage>
      {
        media.map((slide, index) => (
          <figure
            class="project-media-slide"
            data-media-slide
            data-caption={slide.caption}
            data-active={index === 0 ? "" : undefined}
            aria-hidden={index === 0 ? undefined : "true"}
          >
            {slide.kind === "image" ? (
              <Picture
                src={slide.image}
                alt={slide.alt}
                widths={[480, 720, 960, 1280]}
                formats={["avif", "webp"]}
                sizes={sizes}
                quality={75}
                loading={eager && index === 0 ? "eager" : "lazy"}
                fetchpriority={eager && index === 0 ? "high" : "auto"}
                decoding="async"
                class="project-media-image"
                draggable={false}
              />
            ) : (
              <div role="img" aria-label={slide.alt} class="h-full">
                <ProjectVisual visual={slide.visual} />
              </div>
            )}
          </figure>
        ))
      }

      {
        hasControls && isShowcase && (
          <>
            <button
              type="button"
              class="project-media-arrow project-media-arrow--prev btn btn-circle btn-sm"
              data-media-step="-1"
              aria-label={`Previous ${title} screenshot`}
            >
              <span aria-hidden="true">&larr;</span>
            </button>
            <button
              type="button"
              class="project-media-arrow project-media-arrow--next btn btn-circle btn-sm"
              data-media-step="1"
              aria-label={`Next ${title} screenshot`}
            >
              <span aria-hidden="true">&rarr;</span>
            </button>
          </>
        )
      }

      {variant === "card" && hasControls && <span class="project-media-progress" data-media-progress aria-hidden="true" />}
    </div>
  </div>

  {
    hasControls && (
      <div class="project-media-controls" data-media-controls>
        {isShowcase && (
          <span class="project-media-caption" data-media-caption aria-live="polite">
            {first?.caption}
          </span>
        )}
        <span class="project-media-counter" data-media-counter aria-hidden="true">
          1 / {count}
        </span>
        <div class="project-media-dots">
          {media.map((slide, index) => (
            <button
              type="button"
              data-media-dot={index}
              aria-label={`Show ${slide.caption}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
      </div>
    )
  }
</project-media>

<script>
  import "@runtime/elements/project-media";
</script>

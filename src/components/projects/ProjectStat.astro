---
import type { ResolvedProjectStat } from "@content/project_stats";

interface Props {
  stat: ResolvedProjectStat;
  class?: string;
}

const { stat, class: className } = Astro.props;
---

<p class:list={["flex flex-wrap items-baseline gap-x-2", className]} data-project-stat>
  <strong class="font-display text-2xl font-bold tabular-nums text-primary">
    {stat.value}
  </strong>
  <span class="text-sm text-base-content/70">{stat.label}</span>
</p>

---
import ChatVisual from "@components/projects/visuals/ChatVisual.astro";
import FlowVisual from "@components/projects/visuals/FlowVisual.astro";
import RangesVisual from "@components/projects/visuals/RangesVisual.astro";
import TerminalVisual from "@components/projects/visuals/TerminalVisual.astro";
import {
  projectVisuals,
  type ProjectVisualId,
  type ProjectVisualSpec,
} from "@data/project_visuals";

interface Props {
  visual: ProjectVisualId;
}

const { visual } = Astro.props;
const spec: ProjectVisualSpec = projectVisuals[visual];
---

<div class="project-visual" data-project-visual={visual} aria-hidden="true">
  {spec.kind === "terminal" && <TerminalVisual lines={spec.lines} />}
  {
    spec.kind === "flow" && (
      <FlowVisual
        head={spec.head}
        steps={spec.steps}
        {...spec.checkpoint ? { checkpoint: spec.checkpoint } : {}}
      />
    )
  }
  {spec.kind === "ranges" && <RangesVisual {...spec} />}
  {spec.kind === "chat" && <ChatVisual {...spec} />}
</div>

---
import type { ResolvedProjectSummary } from "@content/project_stats";
import ProjectMedia from "@components/projects/ProjectMedia.astro";
import ProjectStat from "@components/projects/ProjectStat.astro";
import TechStack from "@components/projects/TechStack.astro";

interface Props {
  projects: readonly ResolvedProjectSummary[];
}

const { projects } = Astro.props;
---

<section class="w-full" aria-label="Project showcases">
  {
    projects.map((project, index) => {
      const mediaFirst = index % 2 === 0;

      return (
        <div
          data-project-showcase={project.href}
          class:list={[
            "w-full text-base-content",
            index > 0 && "border-t border-base-300",
            index % 2 === 0 ? "bg-base-100" : "bg-base-200",
          ]}
        >
          <article class="group mx-auto grid w-full max-w-screen-2xl grid-cols-1 items-center gap-10 px-4 py-16 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-16">
            <div
              class:list={[
                "flex min-w-0 flex-col justify-center gap-6 lg:col-span-5",
                mediaFirst ? "lg:order-2" : "lg:order-1",
              ]}
            >
              <div class="flex items-center gap-4" aria-hidden="true">
                <span class="font-mono text-sm font-bold text-primary">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="h-px w-12 shrink-0 bg-primary/50" />
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-base-content/60">
                  {project.category}
                </span>
              </div>

              <h2 class="break-words font-display text-4xl font-bold leading-tight sm:text-5xl lg:text-[clamp(2.5rem,3.4vw,3.75rem)]">
                <a
                  href={project.href}
                  class="transition-colors hover:text-primary focus-visible:text-primary"
                  tabindex="-1"
                  data-astro-prefetch
                >
                  {/* Let a dotted name like albertoduran.com wrap at the dot, not mid-word. */}
                  {project.title.split(".").map((part, partIndex) =>
                    partIndex === 0 ? part : [<wbr />, `.${part}`],
                  )}
                </a>
              </h2>

              <p class="max-w-2xl text-lg leading-relaxed text-base-content/70 md:text-xl">
                {project.description}
              </p>

              <ProjectStat stat={project.stat} />

              <TechStack
                stack={project.stack}
                label={`${project.title} stack`}
                size="lg"
              />

              <a
                href={project.href}
                aria-label={`Open the ${project.title} project showcase`}
                class="mt-2 inline-flex w-fit items-center gap-3 border-b-2 border-primary pb-2 font-display text-sm font-bold uppercase tracking-[0.14em] text-primary transition-[gap] duration-200 hover:gap-5 focus-visible:gap-5"
                data-astro-prefetch
              >
                Open project showcase
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

            <ProjectMedia
              title={project.title}
              media={project.media}
              variant="showcase"
              address={project.mediaLabel}
              sizes="(max-width: 1023px) 100vw, 58vw"
              eager={index === 0}
              class:list={["order-first lg:col-span-7", mediaFirst ? "lg:order-1" : "lg:order-2"]}
            />
          </article>
        </div>
      );
    })
  }
</section>

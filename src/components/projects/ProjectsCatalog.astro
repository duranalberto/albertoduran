---
import type { ProjectSummary } from "@data/projects";
import { Picture } from "astro:assets";

interface Props {
  projects: readonly ProjectSummary[];
}

const { projects } = Astro.props;
---

<section class="w-full" aria-label="Project showcases">
  {
    projects.map((project, index) => {
      const mediaFirst = index % 2 === 0;

      return (
        <a
          href={project.href}
          aria-label={`Open the ${project.title} project showcase`}
          data-project-showcase={project.href}
          class:list={[
            "group block w-full text-base-content outline-none transition-colors focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary",
            index > 0 && "border-t border-base-300",
            index % 2 === 0 ? "bg-base-100" : "bg-base-200",
          ]}
          data-astro-prefetch
        >
          <article class="mx-auto grid w-full max-w-screen-2xl grid-cols-1 items-center gap-10 px-4 py-16 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-16">
            <div
              class:list={[
                "flex min-w-0 flex-col justify-center lg:col-span-5",
                mediaFirst ? "lg:order-2" : "lg:order-1",
              ]}
            >
              <div class="mb-7 flex items-center gap-4" aria-hidden="true">
                <span class="font-mono text-sm font-bold text-primary">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="h-px w-12 bg-primary/50" />
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-base-content/60">
                  {project.category}
                </span>
              </div>

              <h2 class="mb-6 break-words font-display text-4xl font-bold leading-tight transition-colors group-hover:text-primary sm:text-5xl xl:text-6xl">
                {project.title}
              </h2>

              <p class="mb-8 max-w-2xl text-lg leading-relaxed text-base-content/70 md:text-xl">
                {project.description}
              </p>

              <ul class="mb-10 flex flex-wrap gap-2" aria-label={`${project.title} technologies`}>
                {project.technologies.map((fact) => (
                  <li class="badge badge-outline border-base-300 px-3 py-3 text-xs font-semibold text-base-content/70">
                    {fact}
                  </li>
                ))}
              </ul>

              <span class="inline-flex w-fit items-center gap-3 border-b-2 border-primary pb-2 font-display text-sm font-bold uppercase tracking-[0.14em] text-primary transition-[gap] duration-200 group-hover:gap-5">
                Open project showcase
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>

            <figure
              class:list={[
                "relative min-w-0 overflow-hidden rounded-box border border-base-300 bg-base-300 shadow-xl lg:col-span-7",
                mediaFirst ? "lg:order-1" : "lg:order-2",
              ]}
            >
              <div class="aspect-[4/3] overflow-hidden">
                <Picture
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[480, 720, 960, 1280]}
                  formats={["avif", "webp"]}
                  sizes="(max-width: 1023px) 100vw, 58vw"
                  quality={80}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                  class="h-full w-full select-none object-cover transition-transform duration-500 group-hover:scale-[1.025]"
                  draggable={false}
                />
              </div>
              <div
                class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-base-content/10"
                aria-hidden="true"
              />
            </figure>
          </article>
        </a>
      );
    })
  }
</section>

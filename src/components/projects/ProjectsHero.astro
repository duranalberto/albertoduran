---
const props = Astro.props;
---

<section class="hero-section overflow-hidden font-sans" {...props}>
  <div class="hero-shell">
    <div class="hero-grid">
      <div class="hero-primary xl:col-span-7">
        <div class="hero-eyebrow" aria-hidden="true">
          <span class="hero-eyebrow-line"></span>
          <p class="hero-eyebrow-label">Selected Engineering Work</p>
        </div>

        <h1
          class="hero-heading mb-8 font-display text-5xl text-base-content md:text-6xl xl:text-8xl"
        >
          <span class="text-primary">My</span>
          {" "}
          <span>Projects</span>
        </h1>

        <p class="hero-description text-lg leading-relaxed text-neutral-content md:text-xl">
          Four projects shaped by different problems: publishing technical
          knowledge, reasoning about uncertain financial data, operating
          resilient scrapers, and building a distributed writing platform.
        </p>
      </div>

      <div class="flex min-w-0 xl:col-span-5 xl:justify-end">
        <div class="flex flex-col border-l-2 border-primary/20 py-2 pl-6">
          <span class="mb-1 text-xs font-bold uppercase tracking-widest text-neutral-content opacity-90">
            Selected work
          </span>
          <span class="font-display text-4xl font-black text-primary">04</span>
          <span class="font-display text-sm uppercase text-base-content">
            Complete case studies
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

---
import "@styles/glass.css";
import backgroundImage from "@assets/atlas/atlas_background.jpg";
import srcImage from "@assets/atlas/atlas_logo.png";
import ParallaxHero from "@layouts/ParallaxHero.astro";
import { Picture, getImage } from "astro:assets";
import { getAtlasData } from "../../../utils/atlas_service";

const buildData = await getAtlasData();

/**
 * ART DIRECTION: Generate specific crops for different devices
 * Using both width and height forces Astro/Sharp to perform a 'smart crop'
 */

// Mobile: Tall crop (800x1200). Perfect for the 140% height parallax on phones.
const mobileImg = await getImage({
  src: backgroundImage,
  width: 800,
  height: 1200,
  format: "webp",
  quality: 70,
});

// Desktop: Wide crop (2560x1080). Optimized for WQHD/Ultra-wide.
const desktopImg = await getImage({
  src: backgroundImage,
  width: 2560,
  height: 1080,
  format: "webp",
  quality: 90,
});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleString("en-US", {
    day: "numeric",
    month: "short",
    weekday: "short",
    hour: "numeric",
    minute: "2-digit",
  });
---

<ParallaxHero>
  <picture slot="background">
    <source
      media="(max-width: 767px)"
      srcset={mobileImg.src}
      width="800"
      height="1200"
    />
    <source
      media="(min-width: 768px)"
      srcset={desktopImg.src}
      width="2560"
      height="1080"
    />
    <img
      src={desktopImg.src}
      alt="Estadio Jalisco background"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div
    class="flex flex-col lg:flex-row items-stretch justify-center gap-8 lg:gap-10 max-w-7xl mx-auto px-4 w-full"
  >
    <div class="flex items-center justify-center w-full lg:w-[35%]">
      <Picture
        src={srcImage}
        alt="Atlas FC"
        widths={[400, 800]}
        sizes="(max-width: 768px) 400px, 600px"
        format="webp"
        quality={80}
        loading="eager"
        class="max-w-full h-auto object-contain select-none contour-solid"
        draggable="false"
      />
    </div>

    <atlas-schedule class="flex flex-col gap-8 lg:gap-10 w-full lg:w-[65%]">
      <div id="match-content" class="flex flex-col gap-8 lg:gap-10 w-full">
        <section
          class="glass-surface glass-interactive rounded-3xl shadow-2xl flex flex-col w-full overflow-hidden"
        >
          <div class="flex flex-col gap-2 w-full">
            <div
              class="metric-card flex items-end justify-between py-4 px-8 min-w-0"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
              >
                Current Standing
              </span>
              <span
                id="stat-standing"
                class="text-2xl font-black leading-none tracking-tight"
              >
                {buildData?.standing || "--"}
              </span>
            </div>

            <div
              class="metric-card flex items-end justify-between py-4 px-8 min-w-0 border-t border-base-content/10"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
              >
                Record
              </span>
              <span
                id="stat-record"
                class="text-xl font-mono font-medium text-base-content leading-none"
              >
                {buildData?.record || "--"}
              </span>
            </div>

            <div
              class="metric-card flex items-end justify-between py-5 px-8 min-w-0 border-t border-base-content/10"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
              >
                Total Points
              </span>
              <span
                id="stat-points"
                class="text-2xl font-black leading-none tracking-tight"
              >
                {buildData?.points ?? "--"}
              </span>
            </div>
          </div>
        </section>

        <section
          class="glass-surface glass-interactive flex flex-col lg:flex-row w-full rounded-3xl shadow-2xl overflow-hidden"
        >
          <div
            class="metric-card flex-2 min-w-0 py-12 pl-8 pr-4 cursor-default"
          >
            <div
              class="flex flex-col text-3xl font-extrabold text-base-content leading-none md:text-4xl lg:text-5xl uppercase"
            >
              <span
                id="home-team"
                class:list={[
                  "wrap-break-word",
                  buildData?.homeTeam.toLowerCase().includes("atlas")
                    ? "text-primary"
                    : "",
                ]}
              >
                {buildData?.homeTeam || "--"}
              </span>

              <span class="text-lg opacity-30 my-2 md:text-2xl">VS</span>

              <span
                id="away-team"
                class:list={[
                  "wrap-break-word",
                  buildData?.awayTeam.toLowerCase().includes("atlas")
                    ? "text-primary"
                    : "",
                ]}
              >
                {buildData?.awayTeam || "--"}
              </span>
            </div>
          </div>

          <div
            class="metric-card flex-1 flex flex-col gap-6 py-4 pl-4 pr-8 md:p-10 border-t lg:border-t-0 lg:border-l border-base-content/10 bg-base-content/2"
          >
            <div class="flex flex-col gap-0.5">
              <span
                class="text-xs font-bold uppercase tracking-widest opacity-60"
                >Date</span
              >
              <span
                id="match-date"
                class="text-base font-bold text-base-content md:text-lg"
                data-raw={buildData?.rawDate}
              >
                {buildData ? formatDate(buildData.rawDate) : "--"}
              </span>
            </div>

            <div class="flex flex-col gap-1">
              <span
                class="text-xs font-bold uppercase tracking-widest opacity-60"
                >Stadium</span
              >
              <div class="flex flex-col items-start">
                <span
                  id="match-stadium"
                  class="text-sm font-bold text-base-content md:text-base leading-tight"
                >
                  {buildData?.stadium || "--"}
                </span>
                <span
                  class="text-xs font-medium opacity-40 uppercase tracking-tighter mt-1"
                >
                  <span id="match-city">{buildData?.city || "--"}</span>
                </span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </atlas-schedule>
  </div>
</ParallaxHero>

<script>
  import "../../../utils/atlas_schedule.ts";
</script>

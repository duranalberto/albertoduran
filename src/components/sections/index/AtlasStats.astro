---
import backgroundImage from "@assets/atlas/atlas_background.jpg";
import srcImage from "@assets/atlas/atlas_logo.png";
import ParallaxHero from "@layouts/ParallaxHero.astro";
import { Picture, getImage } from "astro:assets";
import { getEntry } from "astro:content";

const entry = await getEntry("atlasData", "current-match");
const buildData = entry?.data;

const mobileAvif = await getImage({
  src: backgroundImage,
  width: 640,
  height: 960,
  format: "avif",
  quality: 65,
});

const mobileWebp = await getImage({
  src: backgroundImage,
  width: 640,
  height: 960,
  format: "webp",
  quality: 70,
});

const desktopAvif = await getImage({
  src: backgroundImage,
  width: 1920,
  height: 810,
  format: "avif",
  quality: 70,
});

const desktopWebp = await getImage({
  src: backgroundImage,
  width: 1920,
  height: 810,
  format: "webp",
  quality: 75,
});

const formatDate = (iso: string) =>
  iso && iso !== "--"
    ? new Date(iso).toLocaleString("en-US", {
        day: "numeric",
        month: "short",
        weekday: "short",
        hour: "numeric",
        minute: "2-digit",
      })
    : "--";
---

<ParallaxHero>
  <picture slot="background">
    <source
      media="(max-width: 767px)"
      srcset={mobileAvif.src}
      type="image/avif"
      width="640"
      height="960"
    />
    <source
      media="(max-width: 767px)"
      srcset={mobileWebp.src}
      type="image/webp"
      width="640"
      height="960"
    />
    <source
      media="(min-width: 768px)"
      srcset={desktopAvif.src}
      type="image/avif"
      width="1920"
      height="810"
    />
    <source
      media="(min-width: 768px)"
      srcset={desktopWebp.src}
      type="image/webp"
      width="1920"
      height="810"
    />
    <img
      src={desktopWebp.src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
      width="1920"
      height="810"
    />
  </picture>

  <div
    class="flex flex-col lg:flex-row items-stretch justify-center gap-8 lg:gap-10 max-w-7xl mx-auto px-4 w-full"
  >
    <div class="flex items-center justify-center w-full lg:w-[35%]">
      <Picture
        src={srcImage}
        alt="Atlas FC"
        widths={[200, 400, 800]}
        formats={["avif", "webp"]}
        sizes="(max-width: 1024px) 50vw, 448px"
        quality={85}
        loading="lazy"
        fetchpriority="low"
        class="max-w-full h-auto object-contain select-none contour-solid"
        draggable="false"
        decoding="async"
      />
    </div>

    <atlas-schedule class="flex flex-col gap-8 lg:gap-10 w-full lg:w-[65%]">
      <div id="match-content" class="flex flex-col gap-8 lg:gap-10 w-full">
        <section
          class="glass-surface glass-interactive rounded-3xl shadow-2xl flex flex-col w-full overflow-hidden"
        >
          <div class="flex flex-col gap-2 w-full">
            <div
              class="metric-card flex items-end justify-between py-4 px-8 min-w-0"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
                >Current Standing</span
              >
              <span id="stat-standing" class="text-2xl text-right font-semibold"
                >{buildData?.standing || "--"}</span
              >
            </div>
            <div
              class="metric-card flex items-end justify-between py-4 px-8 border-t border-base-content/10"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
                >Record</span
              >
              <span id="stat-record" class="text-xl text-right"
                >{buildData?.record || "--"}</span
              >
            </div>
            <div
              class="metric-card flex items-end justify-between py-5 px-8 border-t border-base-content/10"
            >
              <span
                class="text-xs uppercase tracking-widest font-bold opacity-60"
                >Total Points</span
              >
              <span id="stat-points" class="text-2xl text-right font-semibold"
                >{buildData?.points ?? "--"}</span
              >
            </div>
          </div>
        </section>

        <section
          class="glass-surface glass-interactive flex flex-col lg:flex-row w-full rounded-3xl shadow-2xl overflow-hidden"
        >
          <div class="metric-card flex-2 py-12 px-8">
            <div
              class="flex flex-col text-3xl font-extrabold uppercase md:text-5xl"
            >
              <span
                id="home-team"
                class={buildData?.homeTeam?.toLowerCase().includes("atlas")
                  ? "text-primary"
                  : ""}
              >
                {buildData?.homeTeam || "--"}
              </span>
              <span class="text-lg opacity-30 my-2">VS</span>
              <span
                id="away-team"
                class={buildData?.awayTeam?.toLowerCase().includes("atlas")
                  ? "text-primary"
                  : ""}
              >
                {buildData?.awayTeam || "--"}
              </span>
            </div>
          </div>

          <div
            class="metric-card flex-1 flex flex-col gap-6 p-8 border-t lg:border-t-0 lg:border-l border-base-content/10 bg-base-content/5"
          >
            <div>
              <span class="block text-xs font-bold uppercase opacity-60"
                >Date</span
              >
              <span
                id="match-date"
                data-raw={buildData?.rawDate}
                class="text-lg font-bold"
              >
                {buildData ? formatDate(buildData.rawDate) : "--"}
              </span>
            </div>
            <div>
              <span class="block text-xs font-bold uppercase opacity-60"
                >Stadium</span
              >
              <span id="match-stadium" class="text-base font-bold"
                >{buildData?.stadium || "--"}</span
              >
              <span id="match-city" class="block text-xs opacity-40 uppercase"
                >{buildData?.city || "--"}</span
              >
            </div>
          </div>
        </section>
      </div>
    </atlas-schedule>
  </div>
</ParallaxHero>

---
import SocialTire from "@components/ui/SocialTire.astro";
const props = Astro.props;
---

<section class="relative overflow-hidden py-12 lg:py-24" {...props}>
  <div class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <div class="flex flex-col items-start text-left lg:col-span-8">
        <div class="flex items-center gap-3 mb-6 select-none">
          <span class="h-px w-8 bg-primary"></span>
          <p
            class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary md:text-sm"
          >
            Software Engineer
          </p>
        </div>

        <h1
          class="mb-8 font-black font-display text-5xl md:text-7xl lg:text-8xl select-none"
        >
          <span class="text-primary" transition:name="hero-title-first"
            >Alberto</span
          ><span transition:name="hero-title-second" class="text-base-content"
            >Duran</span
          >
        </h1>

        <div
          class="max-w-2xl mb-10 text-lg leading-relaxed text-neutral-content lg:text-xl"
          transition:name="hero-description"
        >
          <p class="mb-6">
            I’m glad you’re here! You’ve found my tiny space in the digital
            world. Feel free to explore: whether it’s for recruiting, reading my
            publications in
            <a
              href="/thejournal/"
              class="font-bold text-primary decoration-primary/30 hover:underline"
            >
              TheJournal.
            </a> or just looking around. ✨
          </p>

          <p
            class="pl-6 border-l-2 border-primary/30 italic text-base-content/90"
          >
            <span class="not-italic font-bold text-primary">Hiring?</span>
            Skip the small talk and head straight to my
            <a
              href="/profile/"
              class="font-bold underline decoration-primary/50 transition-colors hover:text-primary"
            >
              Professional Profile
            </a>
            to see my technical skills and experience.
          </p>
        </div>

        <SocialTire />
      </div>

      <div class="hidden relative lg:block lg:col-span-4">
        <div class="absolute -inset-4 rounded-full bg-primary/5 blur-3xl"></div>
        <div class="relative py-4 pl-8 border-l-4 border-primary">
          <span
            class="block font-display text-8xl font-black leading-none tracking-[0.04em] uppercase text-base-content/10 select-none"
          >
            Craft <br />Insight<br />Impact
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { type Awards } from "@appTypes/about";

interface Props {
  awards: Awards[];
}

const { awards } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
  {
    awards.map((award) => (
      <!--
        transition-[transform,box-shadow] instead of transition-all.
        transition-all on bg-base-200 text-base-content would animate both
        background and text color on theme switch (200ms visible lag).
      -->
      <div class="card card-border bg-base-200 text-base-content rounded-box shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-xl flex flex-col items-start p-6 will-change-transform">
        <h3 class="font-display text-lg font-bold leading-tight">
          {award.title}
        </h3>

        <p class="mt-1 text-[10px] font-bold tracking-widest uppercase text-neutral-content opacity-90">
          {award.org}
        </p>

        <p class="mt-3 text-sm leading-relaxed text-neutral-content opacity-90">
          {award.desc}
        </p>

        {award.link && (
          <a
            href={award.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-auto inline-flex items-center gap-1 pt-4 text-xs font-semibold text-primary transition-all hover:gap-2"
          >
            View Recognition
            <span
              class="transition-transform group-hover:translate-x-0.5"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        )}
      </div>
    ))
  }
</div>
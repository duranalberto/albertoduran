---
import type { Education } from "@appTypes/about";

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<div class="flex flex-col gap-8">
  {
    education.map((edu) => (
      <div class="flex flex-col gap-2">
        <h3 class="font-display text-lg font-bold text-base-content">
          {edu.school}
        </h3>

        <p class="text-sm text-neutral-content opacity-90">{edu.degree}</p>
        <p class="text-xs text-primary mt-1">{edu.period}</p>
      </div>
    ))
  }
</div>

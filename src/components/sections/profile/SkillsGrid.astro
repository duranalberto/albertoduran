---
import { type Skills } from "@appTypes/about";
import SVGIcon from "@components/ui/SVGIcon.astro";

interface Props {
  skills: Skills[];
}

const { skills } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-16">
  {
    skills.map((skill) => (
      <div class="flex flex-col gap-8">
        <h3 class="font-display text-[12px] font-bold tracking-[0.3em] uppercase text-neutral-content opacity-90 min-h-8 flex items-end">
          {skill.category}
        </h3>
        <div class="flex flex-wrap justify-start gap-x-10 gap-y-10">
          {skill.skills_icons.map((skill_icon) => (
            <div class="flex flex-col items-center gap-4 w-24">
              <div class="text-neutral-content opacity-90">
                <SVGIcon icon={skill_icon} class="h-20 w-20" />
              </div>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-content opacity-90 text-center leading-tight">
                {skill_icon.text}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

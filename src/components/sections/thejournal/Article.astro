---
const { class: className, ...props } = Astro.props;
---

<article
  class:list={[
    "prose prose-journal",
    "prose-base md:prose-lg lg:prose-xl",
    "w-full max-w-4xl min-w-0 mx-auto isolate overflow-visible",
    "break-words",
    "prose-headings:font-display prose-headings:font-extrabold prose-headings:tracking-tight",
    "prose-img:rounded-xl",
    "prose-code",
    "touch-manipulation",
    className,
  ]}
  {...props}
>
  <slot />
</article>

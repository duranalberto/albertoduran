---
import SidebarBase from "@components/common/SidebarBase.astro";
import OnThisPageContent from "@components/sections/thejournal/OnThisPageContent.astro";
import { ui } from "@data/icons";
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
  expandedWidth?: string;
}

const { headings, expandedWidth = "16rem" } = Astro.props;

if (headings.length === 0) return null;
---

<SidebarBase
  title="On This Page"
  icon={ui.onThisPage}
  badgeCount={headings.length}
  expandedWidth={expandedWidth}
  side="right"
>
  <OnThisPageContent headings={headings} tracked={true} compact={true} />
</SidebarBase>

<script>
  import "@utils/on_this_page.ts";
</script>

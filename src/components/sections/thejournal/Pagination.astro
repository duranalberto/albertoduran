---
import { type EntryContext } from "@appTypes/content_context";

interface Props {
  prevEntry: EntryContext | null;
  nextEntry: EntryContext | null;
}

const { prevEntry, nextEntry } = Astro.props;
---

<nav
  aria-label="Journal entry navigation"
  class="flex flex-col gap-6 mt-24 pt-12 border-t border-base-300"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      prevEntry ? (
        <a
          href={`/thejournal/${prevEntry.id}`}
          class="group flex flex-col justify-between h-full p-6 text-left"
        >
          <span class="text-xs font-semibold uppercase text-neutral-content opacity-90 group-hover:text-primary">
            &larr; Previous
          </span>
          <span class="mt-4 font-display text-lg font-semibold text-base-content group-hover:text-primary">
            {prevEntry.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
    {
      nextEntry ? (
        <a
          href={`/thejournal/${nextEntry.id}`}
          class="group flex flex-col justify-between h-full p-6 text-right"
        >
          <span class="text-xs font-semibold uppercase text-neutral-content opacity-90 group-hover:text-primary">
            Next &rarr;
          </span>
          <span class="mt-4 font-display text-lg font-semibold text-base-content group-hover:text-primary">
            {nextEntry.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</nav>

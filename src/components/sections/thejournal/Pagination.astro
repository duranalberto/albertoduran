---
import { type EntryContext } from "@appTypes/content_context";

interface Props {
  prevEntry: EntryContext | null;
  nextEntry: EntryContext | null;
}

const { prevEntry, nextEntry } = Astro.props;
---

<nav
  aria-label="Journal entry navigation"
  class="w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4"
>
  {
    prevEntry ? (
      <a
        href={`/thejournal/${prevEntry.id}/`}
        class="pagination-card card bg-base-100 border border-base-200 shadow-sm group"
        data-astro-prefetch
      >
        <div class="card-body p-6 flex flex-col items-start text-left">
          <span class="pagination-label text-xs font-bold tracking-wider uppercase text-base-content/50 mb-2 flex items-center gap-2">
            &larr; Previous
          </span>
          <span class="font-display text-lg font-semibold text-base-content line-clamp-2">
            {prevEntry.title}
          </span>
        </div>
      </a>
    ) : (
      <div class="hidden md:block" aria-hidden="true" />
    )
  }

  {
    nextEntry ? (
      <a
        href={`/thejournal/${nextEntry.id}/`}
        class="pagination-card card bg-base-100 border border-base-200 shadow-sm group"
        data-astro-prefetch
      >
        <div class="card-body p-6 flex flex-col items-end text-right">
          <span class="pagination-label text-xs font-bold tracking-wider uppercase text-base-content/50 mb-2 flex items-center gap-2">
            Next &rarr;
          </span>
          <span class="font-display text-lg font-semibold text-base-content line-clamp-2">
            {nextEntry.title}
          </span>
        </div>
      </a>
    ) : (
      <div class="hidden md:block" aria-hidden="true" />
    )
  }
</nav>

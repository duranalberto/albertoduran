---
import type { EntryContext, VaultContext } from "@appTypes/content_context";
import Button from "@components/ui/Button.astro";
import SVGIcon from "@components/ui/SVGIcon.astro";
import { social, ui } from "@data/icons";
import { Picture } from "astro:assets";

interface Props {
  entry: EntryContext;
  vaultContext: VaultContext;
}

const { entry, vaultContext } = Astro.props;

const image = entry.image;
const github = entry.github;
const formattedDate = new Date(entry.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readTimeText = entry.readTime ? `${entry.readTime} min read` : null;
---

<header
  class="article-header-root flex flex-col gap-8 mb-8 md:mb-10 xl:mb-14 max-w-screen-2xl mx-auto contain-paint"
>
  <div class="flex flex-col gap-4">
    {
      vaultContext && (
        <nav aria-label="Breadcrumb">
          <a
            href={`/thejournal/${vaultContext.id}/`}
            transition:name={`article-vault-button-${entry.vaultId}`}
            class="badge badge-outline inline-flex active:scale-95 items-center min-h-8 px-3 py-2 text-xs font-bold tracking-widest uppercase transition-colors hover:bg-primary hover:text-primary-content"
          >
            {vaultContext.title}
          </a>
        </nav>
      )
    }

    <h1
      id="article-header"
      transition:name={`article-title`}
      class="font-display block text-4xl font-black text-base-content md:text-5xl lg:text-7xl"
    >
      {entry.title}
    </h1>

    <div
      class="flex flex-wrap items-center gap-x-6 gap-y-4 text-sm font-medium text-neutral-content"
      transition:name={`article-metadata`}
    >
      <div class="flex items-center gap-2 whitespace-nowrap">
        <SVGIcon icon={ui.calendar} class="size-4 text-neutral-content/70" />
        <time datetime={entry.pubDate.toISOString()}>
          {formattedDate}
        </time>
      </div>

      {
        readTimeText && (
          <div class="flex items-center gap-2 whitespace-nowrap">
            <SVGIcon icon={ui.clock} class="size-4 text-neutral-content/70" />
            <span>{readTimeText}</span>
          </div>
        )
      }

      {
        entry.tags.length > 0 && (
          <div class="flex items-center gap-2">
            <SVGIcon icon={ui.tag} class="size-4 text-neutral-content/70" />
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              {entry.tags.map((tag) => (
                <span class="py-1 text-neutral-content/70">#{tag}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        github && (
          <div class="w-full mt-2 sm:mt-0 sm:ml-auto sm:w-auto">
            <Button
              icon={social.github}
              label="Repository"
              variant="btn-outline"
              href={`https://github.com/duranalberto/${github}`}
              ariaLabel="Project repository"
              isExternal
              class="group w-full min-h-8 h-10 sm:h-8 sm:w-auto border-base-300 transition-all hover:bg-primary hover:text-primary-content hover:border-primary"
            />
          </div>
        )
      }
    </div>
  </div>

  {
    image && (
      <div
        class="article-image-wrapper rounded-box relative w-full overflow-hidden border border-base-300 bg-base-200 shadow-sm layer-gpu"
        transition:name={`article-image-${image.src}`}
      >
        <Picture
          src={image}
          alt={entry.title}
          widths={[500, 800, 1000, 1200, 1500]}
          formats={["avif", "webp"]}
          sizes="(max-width: 1024px) 100vw, (max-width: 1536px) calc(100vw - 36rem), 900px"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="article-featured-img w-full h-full select-none object-cover transition-transform duration-500 hover:scale-105 motion-safe:will-change-transform"
          draggable={false}
        />
      </div>
    )
  }
</header>

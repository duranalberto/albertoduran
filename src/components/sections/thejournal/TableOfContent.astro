---
import type { VaultContext } from "@appTypes/content_context";
import VaultTreeNode from "@components/ui/VaultTreeNode.astro";
import SVGIcon from "@components/ui/SVGIcon.astro";
import { ui } from "@data/icons";

interface Props {
  vault: VaultContext;
  currentEntryId: string;
}

const { vault, currentEntryId } = Astro.props;
---

<vault-sidebar>
  <nav
    id="toc-sidebar"
    aria-label="Vault navigation"
    data-collapsed="false"
    class="group sticky top-20 flex flex-col self-start flex-none max-w-72 w-72 max-h-[calc(100dvh-8rem)] overflow-hidden bg-base-100 text-base-content border-r border-transparent transition-all duration-200 ease-in-out data-[collapsed=true]:w-14 data-[collapsed=true]:border-base-300"
  >
    <div class="flex items-center justify-between">
      <button
        type="button"
        id="toc-toggle"
        aria-label="Toggle navigation"
        aria-expanded="true"
        aria-controls="toc-content"
        class="flex items-center w-full py-2"
      >
        <h2
          id="toc-heading"
          class="text-xs font-semibold uppercase tracking-wide text-neutral-content transition-opacity duration-150 group-data-[collapsed=true]:hidden"
        >
          Table of Contents
        </h2>

        <span class="toc-icon flex items-center justify-center ml-auto">
          <SVGIcon icon={ui.toggleLeft} class="color-base-300" />
        </span>
      </button>
    </div>

    <div
      id="toc-content"
      role="region"
      aria-labelledby="toc-heading"
      class="hidden menu flex-1 min-h-0 overflow-y-auto px-0 transition-opacity duration-200 group-data-[collapsed=false]:block w-full"
    >
      <ul class="relative border-r border-base-300">
        {
          [vault.index, ...vault.items].map((item) => (
            <li class="relative">
              <VaultTreeNode
                item={item}
                currentEntryId={currentEntryId}
                level={0}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</vault-sidebar>

<style>
  #toc-toggle {
    min-height: 2.5rem;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }

  #toc-sidebar[data-collapsed="false"] #toc-toggle {
    justify-content: space-between;
  }

  #toc-sidebar[data-collapsed="true"] #toc-toggle {
    justify-content: center;
  }

  .toc-icon {
    color: var(--color-base-300);
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 160ms ease;
    will-change: transform, color;
  }

  @media (hover: hover) {
    #toc-toggle:hover .toc-icon {
      color: var(--color-neutral-content);
    }
  }

  #toc-sidebar[data-collapsed="true"] .toc-icon {
    margin-left: 0;
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    #toc-sidebar[data-collapsed="false"] #toc-toggle:hover .toc-icon {
      transform: translateX(-2px);
    }

    #toc-sidebar[data-collapsed="true"] #toc-toggle:hover .toc-icon {
      transform: translateX(2px) rotate(180deg);
    }
  }

  #toc-heading {
    transition:
      opacity 120ms ease,
      visibility 0s linear 120ms;
  }

  #toc-sidebar[data-collapsed="true"] #toc-heading {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 80ms ease,
      visibility 0s linear 0s;
  }

  #toc-sidebar[data-collapsed="false"] #toc-heading {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 120ms ease 160ms,
      visibility 0s linear 0s;
  }

  #toc-content {
    scrollbar-width: thin;
    scrollbar-color: var(--color-base-300) transparent;
  }

  #toc-content::-webkit-scrollbar {
    width: 4px;
  }

  #toc-content::-webkit-scrollbar-thumb {
    background: var(--color-base-300);
    border-radius: var(--radius-box);
  }

  #toc-content:where(:focus-visible) {
    outline: none;
  }
</style>

<script>
  class VaultSidebar extends HTMLElement {
    private toggleBtn: HTMLButtonElement | null = null;
    private sidebar: HTMLElement | null = null;

    connectedCallback() {
      this.sidebar = this.querySelector("#toc-sidebar");
      this.toggleBtn = this.querySelector("#toc-toggle");

      if (this.sidebar && this.toggleBtn) {
        this.toggleBtn.addEventListener("click", this.handleToggle);
      }
    }

    private handleToggle = () => {
      if (!this.sidebar || !this.toggleBtn) return;

      const isCollapsed =
        this.sidebar.getAttribute("data-collapsed") === "true";
      const newState = !isCollapsed;

      this.sidebar.setAttribute("data-collapsed", String(newState));
      this.toggleBtn.setAttribute("aria-expanded", String(!newState));
    };

    disconnectedCallback() {
      if (this.toggleBtn) {
        this.toggleBtn.removeEventListener("click", this.handleToggle);
      }
    }
  }

  if (!customElements.get("vault-sidebar")) {
    customElements.define("vault-sidebar", VaultSidebar);
  }
</script>

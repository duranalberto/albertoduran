---
import ProjectCard from "@components/projects/ProjectCard.astro";
import { withResolvedStats } from "@content/project_stats";
import { featuredProjects } from "@data/projects";

const projects = withResolvedStats(featuredProjects);
---

<div
  class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-12 lg:gap-8"
  data-project-grid
>
  {
    projects.map((project, index) => (
      <ProjectCard project={project} wide={index === 0 || index === 3} />
    ))
  }
</div>

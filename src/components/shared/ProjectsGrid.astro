---
import ProjectCard from "@components/projects/ProjectCard.astro";
import { projectCatalog } from "@data/projects";
---

<div
  class="grid w-full auto-rows-fr grid-cols-1 place-items-stretch gap-8 md:grid-cols-2 lg:gap-10"
  data-project-grid
>
  {
    projectCatalog.map((project, index) => (
      <ProjectCard project={project} index={index} />
    ))
  }
</div>

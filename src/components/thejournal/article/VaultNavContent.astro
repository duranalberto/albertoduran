---
import { type VaultContext } from "@appTypes/content_context";
import VaultTreeNode from "./VaultTreeNode.astro";

interface Props {
  vault: VaultContext;
  currentEntryId: string;
  /** Static trees (the mobile overlay) never draw the active side line. */
  isStatic?: boolean;
}

const { vault, currentEntryId, isStatic = true } = Astro.props;
---

<ul class="menu menu-sm w-full p-0">
  {
    [vault.index, ...vault.items].map((item) => (
      <li>
        <VaultTreeNode
          item={item}
          currentEntryId={currentEntryId}
          isStatic={isStatic}
        />
      </li>
    ))
  }
</ul>

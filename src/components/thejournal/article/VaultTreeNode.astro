---
import { type VaultItem, isNestedGroup } from "@appTypes/content_context";

interface Props {
  item: VaultItem;
  currentEntryId: string;
  level: number;
  isStatic?: boolean;
  classNames?: string;
}

const {
  item,
  currentEntryId,
  level,
  isStatic = false,
  classNames,
} = Astro.props;

const folder = isNestedGroup(item);
const id = folder ? item.index.id : item.id;
const isActive = currentEntryId === id;
const href = `/thejournal/${id}/`;
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  data-state={isActive ? "active" : "inactive"}
  class:list={[
    "vault-tree-node journal-nav-item group flex items-center relative w-full py-2.5 pr-4",
    "text-sm font-medium leading-snug select-none whitespace-normal",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-inset",
    "nav-item py-2.5 pr-4 text-sm font-medium leading-snug whitespace-normal",
    classNames,
  ]}
  data-astro-prefetch
>
  {
    isActive && !isStatic && (
      <div
        class="vault-active-line absolute right-0 top-0 bottom-0 w-1 bg-primary z-20"
      />
    )
  }

  <span class="relative z-10 block w-full">
    {item.title}
  </span>
</a>

{
  folder && item.items.length > 0 && (
    <ul class="flex flex-col">
      {item.items.map((child) => (
        <li>
          <Astro.self
            item={child}
            currentEntryId={currentEntryId}
            level={level + 1}
          />
        </li>
      ))}
    </ul>
  )
}

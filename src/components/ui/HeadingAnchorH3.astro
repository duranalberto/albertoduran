---
/**
 * HeadingAnchorH3.astro
 *
 * Thin wrapper used exclusively for MDX h3 component substitution.
 * When MDX maps `h3: HeadingAnchorH3`, it calls this component in place of
 * every <h3>. We forward all props and pass `as="h3"` so HeadingAnchor
 * renders the correct semantic HTML element.
 *
 * Without this wrapper, both h2 and h3 would map to HeadingAnchor's default
 * of `as || "h2"`, collapsing all subheadings to <h2> and breaking
 * WCAG 1.3.1 heading hierarchy for screen readers and document outline tools.
 */
import HeadingAnchor from "./HeadingAnchor.astro";
const props = Astro.props;
---

<HeadingAnchor as="h3" {...props}><slot /></HeadingAnchor>

---
import Button from "@components/ui/Button.astro";

interface Props {
  title: string;
  linkHref?: string;
  linkLabel?: string;
  linkExternal?: boolean;
}

const { title, linkHref, linkLabel, linkExternal = false } = Astro.props;
---

<div
  class="flex flex-col w-full max-w-screen-2xl mx-auto gap-6 py-8 md:py-10 sm:flex-row sm:items-center sm:justify-between sm:gap-0"
>
  <div class="flex items-center h-10 md:h-12 gap-4 border-l-4 border-primary">
    <h2
      class="pl-4 text-3xl sm:text-4xl font-display font-semibold tracking-tight text-base-content"
    >
      {title}
    </h2>
  </div>

  {
    linkHref && linkLabel && (
      <div class="self-start sm:self-auto">
        <Button
          href={linkHref}
          label={linkLabel}
          size="btn-lg"
          variant="btn-primary"
          isExternal={linkExternal}
          ariaLabel={linkLabel}
          class="shadow-lg active:scale-95 transition-transform"
        />
      </div>
    )
  }
</div>

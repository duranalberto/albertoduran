---
import { skills } from "@data/icons";
import { generateRibbonSVGData } from "@utils/ribbon";

interface Props {
  iconSize?: number;
  gap?: number;
  speed?: string;
  opacity?: string;
}

const {
  iconSize = 40,
  gap = 48,
  speed = "30s",
  opacity = "opacity-30",
} = Astro.props;

const skillsList = Object.values(skills);

const { innerContent, svgWidth, svgHeight } = generateRibbonSVGData(
  skillsList,
  { iconSize, gap, verticalPadding: 24 },
);

const cleanWidth = Math.ceil(svgWidth);
const cleanHeight = Math.ceil(svgHeight);

const patternId = `ribbon-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  class:list={[
    "ribbon-viewport absolute inset-0 z-0 overflow-hidden pointer-events-none touch-none",
    opacity,
  ]}
  aria-hidden="true"
>
  <svg
    class="absolute opacity-0 pointer-events-none"
    style="width: 1px; height: 1px; left: -1px; top: -1px;"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id={patternId}
        x="0"
        y="0"
        width={cleanWidth}
        height={cleanHeight}
        patternUnits="userSpaceOnUse"
      >
        <g set:html={innerContent} />
      </pattern>
    </defs>
  </svg>

  <div
    class="absolute inset-0 w-full h-full isolation-auto transform-gpu"
    style={{
      "mask-image": `repeating-linear-gradient(to bottom, black 0px, black ${cleanHeight}px, transparent ${cleanHeight}px, transparent ${cleanHeight * 2}px)`,
      "-webkit-mask-image": `repeating-linear-gradient(to bottom, black 0px, black ${cleanHeight}px, transparent ${cleanHeight}px, transparent ${cleanHeight * 2}px)`,
    }}
  >
    <div
      class="move-right layer-gpu absolute top-0 bottom-0"
      style={{
        left: `-${cleanWidth}px`,
        width: `calc(100% + ${cleanWidth * 2}px)`,
        "--strip-width": `${cleanWidth}px`,
        "--anim-speed": speed,
      }}
    >
      <svg class="w-full h-full" preserveAspectRatio="none">
        <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
      </svg>
    </div>
  </div>

  <div
    class="absolute inset-0 w-full h-full isolation-auto transform-gpu"
    style={{
      "mask-image": `repeating-linear-gradient(to bottom, transparent 0px, transparent ${cleanHeight}px, black ${cleanHeight}px, black ${cleanHeight * 2}px)`,
      "-webkit-mask-image": `repeating-linear-gradient(to bottom, transparent 0px, transparent ${cleanHeight}px, black ${cleanHeight}px, black ${cleanHeight * 2}px)`,
    }}
  >
    <div
      class="move-left layer-gpu absolute top-0 bottom-0"
      style={{
        left: "0px",
        width: `calc(100% + ${cleanWidth}px)`,
        "--strip-width": `${cleanWidth}px`,
        "--anim-speed": speed,
      }}
    >
      <svg class="w-full h-full" preserveAspectRatio="none">
        <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
      </svg>
    </div>
  </div>
</div>

<style>
  .ribbon-viewport {
    contain: strict;
    isolation: isolate;
    perspective: 1000px;
    transform: translateZ(0);
  }

  .layer-gpu {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    will-change: transform;
    -webkit-perspective: 1000;
  }

  .move-right {
    animation: slide-right var(--anim-speed) linear infinite;
  }
  .move-left {
    animation: slide-left var(--anim-speed) linear infinite;
  }

  @keyframes slide-right {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--strip-width), 0, 0.1px);
    }
  }

  @keyframes slide-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(var(--strip-width) * -1), 0, 0.1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .move-right,
    .move-left {
      animation: none;
    }
  }
</style>

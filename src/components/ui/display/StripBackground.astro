---
import { skills } from "@data/icons";
import { generateRibbonSVGData } from "@utils/ribbon";

interface Props {
  iconSize?: number;
  gap?: number;
  speed?: string;
  opacity?: string;
}

const {
  iconSize = 50,
  gap = 58,
  speed = "45s",
  opacity = "opacity-20",
} = Astro.props;

const skillsList = Object.values(skills);

const { innerContent, svgWidth, svgHeight } = generateRibbonSVGData(
  skillsList,
  { iconSize, gap, verticalPadding: 24 },
);

const cleanWidth = Math.ceil(svgWidth / 2) * 2;
const cleanHeight = Math.ceil(svgHeight / 2) * 2;

const patternIdRight = `ribbon-right-${Math.random().toString(36).substring(2, 9)}`;
const patternIdLeft = `ribbon-left-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  class:list={[
    "ribbon-viewport absolute inset-0 z-0 overflow-hidden pointer-events-none touch-none",
    opacity,
  ]}
  aria-hidden="true"
>
  <div
    class="absolute inset-0 w-full h-full isolation-auto transform-gpu mask-container"
    style={{
      "mask-image": `repeating-linear-gradient(to bottom, black 0px, black ${cleanHeight}px, transparent ${cleanHeight}px, transparent ${cleanHeight * 2}px)`,
      "-webkit-mask-image": `repeating-linear-gradient(to bottom, black 0px, black ${cleanHeight}px, transparent ${cleanHeight}px, transparent ${cleanHeight * 2}px)`,
    }}
  >
    <div
      class="move-right layer-gpu absolute top-0 bottom-0"
      style={{
        left: "0px",
        width: `calc(100% + ${cleanWidth * 2}px)`,
        "--strip-width": `${cleanWidth}px`,
        "--anim-speed": speed,
      }}
    >
      <svg class="w-full h-full" preserveAspectRatio="none">
        <defs>
          <pattern
            id={patternIdRight}
            x="0"
            y="0"
            width={cleanWidth}
            height={cleanHeight}
            patternUnits="userSpaceOnUse"
          >
            <g set:html={innerContent} shape-rendering="optimizeSpeed" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patternIdRight})`}
        ></rect>
      </svg>
    </div>
  </div>

  <div
    class="absolute inset-0 w-full h-full isolation-auto transform-gpu mask-container"
    style={{
      "mask-image": `repeating-linear-gradient(to bottom, transparent 0px, transparent ${cleanHeight}px, black ${cleanHeight}px, black ${cleanHeight * 2}px)`,
      "-webkit-mask-image": `repeating-linear-gradient(to bottom, transparent 0px, transparent ${cleanHeight}px, black ${cleanHeight}px, black ${cleanHeight * 2}px)`,
    }}
  >
    <div
      class="move-left layer-gpu absolute top-0 bottom-0"
      style={{
        left: "0px",
        width: `calc(100% + ${cleanWidth}px)`,
        "--strip-width": `${cleanWidth}px`,
        "--anim-speed": speed,
      }}
    >
      <svg class="w-full h-full" preserveAspectRatio="none">
        <defs>
          <pattern
            id={patternIdLeft}
            x="0"
            y="0"
            width={cleanWidth}
            height={cleanHeight}
            patternUnits="userSpaceOnUse"
          >
            <g set:html={innerContent} shape-rendering="optimizeSpeed" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patternIdLeft})`}></rect>
      </svg>
    </div>
  </div>
</div>

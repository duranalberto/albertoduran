---
import { ui } from "@data/icons";
import SVGIcon from "../primitive/SVGIcon.astro";

const sunIcon = ui.sun!;
const moonIcon = ui.moon!;
---

<div class="js-only">
  <label class="swap swap-rotate" aria-label="Toggle dark mode">
    <input
      type="checkbox"
      id="theme-toggle-input"
      class="theme-controller"
      value="dark"
    />

    <SVGIcon
      icon={sunIcon}
      class="swap-off h-6 w-6 fill-current"
      aria-hidden="true"
    />

    <SVGIcon
      icon={moonIcon}
      class="swap-on h-6 w-6 fill-current"
      aria-hidden="true"
    />
  </label>
</div>

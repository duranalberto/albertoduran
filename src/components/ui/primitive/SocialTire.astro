---
import { social } from "@data/icons";
import { socialLinks } from "@data/identity";
import OutlineActionButton from "@components/ui/primitive/OutlineActionButton.astro";

const linkedInIcon = social.linkedIn;
const githubIcon = social.github;
---

<div class="flex flex-wrap items-center gap-6">
  <OutlineActionButton
    icon={linkedInIcon}
    href={socialLinks.linkedIn.href}
    ariaLabel={socialLinks.linkedIn.label}
    isExternal
    class="w-32 group"
  />

  <OutlineActionButton
    icon={githubIcon}
    href={socialLinks.github.href}
    ariaLabel={socialLinks.github.label}
    isExternal
    class="w-32 group"
  />

  <div class="select-none">
    <div
      class="badge badge-success badge-outline gap-2 px-4 py-3 font-medium border-2"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-success"
        ></span>
      </span>
      Open to new opportunities
    </div>
  </div>
</div>

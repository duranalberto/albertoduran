---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  title: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  external?: boolean;
}

const { title, href, image, imageAlt = title, external } = Astro.props;

const isExternal =
  external ?? (href?.startsWith("http") || href?.startsWith("//"));
const Tag = href ? "a" : "div";

const linkAttrs = href
  ? {
      href,
      target: isExternal ? "_blank" : undefined,
      rel: isExternal ? "noopener noreferrer" : undefined,
      "data-astro-prefetch": "hover",
    }
  : {};
---

<Tag
  {...linkAttrs}
  class:list={[
    "group block w-full h-full transition-all duration-200",
    href &&
      "rounded-box focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 transition-transform",
  ]}
>
  <div
    class="card card-border flex h-full flex-col overflow-hidden bg-base-200 text-base-content shadow-sm transition-all duration-200 will-change-transform group-hover:-translate-y-1 group-hover:shadow-xl"
  >
    {
      image && (
        <figure class="relative block h-52 w-full overflow-hidden border-b border-base-300 bg-base-300">
          <div
            class="font-display absolute inset-0 flex items-center justify-center text-4xl font-bold text-base-content/10 transition-transform duration-200 group-hover:scale-105"
            aria-hidden="true"
          >
            {title?.charAt(0)}
          </div>

          <Picture
            src={image}
            alt={imageAlt}
            widths={[250, 500, 800]}
            quality={60}
            formats={["webp"]}
            sizes="(max-width: 480px) 250px, (max-width: 768px) 400px"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full select-none object-cover transition-transform duration-200 group-hover:scale-105"
            draggable={false}
          />
        </figure>
      )
    }

    <div class="card-body">
      <div class="flex flex-col gap-4">
        <slot name="meta" />

        <h2
          class="card-title transition-colors duration-200 group-hover:text-primary"
        >
          {title}
        </h2>

        <div class="text-base leading-relaxed text-base-content/80">
          <slot />
        </div>
      </div>

      <div
        class="mt-6 flex items-center justify-between border-t border-base-300 pt-4"
      >
        <div class="flex-1">
          <slot name="footer" />
        </div>

        {
          href && (
            <span
              class="text-primary -translate-x-2 font-bold opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
              aria-hidden="true"
            >
              &rarr;
            </span>
          )
        }
      </div>
    </div>
  </div>
</Tag>

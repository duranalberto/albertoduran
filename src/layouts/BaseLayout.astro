---
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";
import FlexShell from "@layouts/FlexShell.astro";
import { Font, getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "@styles/global.css";
import kirby from "@assets/thejournal/pub/kirby.jpg";
import type { SiteManifest } from "@appTypes/navigation";

interface Props {
  siteManifest: SiteManifest;
  image?: ImageMetadata;
}

const { siteManifest, image = kirby } = Astro.props;

const hasHero = Astro.slots.has("hero");
const optimizedImage = await getImage({ src: image, format: "webp" });

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(optimizedImage.src, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{siteManifest.pageTitle}</title>

    <meta
      name="theme-color"
      id="meta-theme-color"
      content="#ffffff"
      transition:persist
    />

    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        })();
        const theme =
          stored ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        root.style.setProperty("color-scheme", theme);
        root.classList.remove("no-js");

        const meta = document.getElementById("meta-theme-color");
        if (meta) {
          meta.setAttribute(
            "content",
            theme === "dark" ? "#121212" : "#ffffff",
          );
        }
      })();
    </script>

    <meta name="description" content={siteManifest.pageTitle} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteManifest.pageTitle} />
    <meta property="og:description" content={siteManifest.description} />
    <meta property="og:image" content={socialImageURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
      transition:persist
    />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-reading" />
    <Font cssVariable="--font-fira-code" />
    <ClientRouter />
  </head>

  <body
    class="flex flex-col min-h-dvh bg-base-100 text-base-content selection:bg-primary/30"
  >
    <Header />
    {
      hasHero ? (
        <FlexShell class="py-0 md:py-0" transition:name="page-hero">
          <slot name="hero" />
        </FlexShell>
      ) : (
        <div transition:name="page-hero" aria-hidden="true" />
      )
    }

    <main
      id="main-content"
      class="grow outline-none"
      transition:name="page-main"
      transition:animate="fade"
    >
      <slot />
    </main>

    <Footer />
    <slot name="overlays" />

    <script>
      import "@runtime/elements/mermaid-diagram-shell";
      import "@runtime/managers/theme_manager";
    </script>
  </body>
</html>

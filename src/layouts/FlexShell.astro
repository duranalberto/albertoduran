---
export interface Props {
  id?: string;
  class?: string;
  as?: "div" | "section" | "article" | "nav" | "main" | "header";
  maxWidth?: string;
}

// Horizontal gutters only; callers own vertical padding through `class`.
// Classes stay literal so Tailwind can see them.
const {
  id,
  class: className,
  as: Tag = "div",
  maxWidth = "max-w-screen-2xl",
} = Astro.props;
---

<Tag id={id} class:list={["mx-auto w-full px-4 md:px-8", maxWidth, className]}>
  <slot />
</Tag>

---
import type { ProjectPageConfig } from "@appTypes/project";
import ProjectHero from "@components/projects/ProjectHero.astro";
import ProjectVaultSection from "@components/projects/ProjectVaultSection.astro";
import { defineJournalLinks } from "@content/define_journal_links";
import {
  assertProjectJournalLink,
  buildSiteManifest,
} from "@data/project_page";
import { vaultsManifest } from "@content/processors/thejournal";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";

interface Props {
  project: ProjectPageConfig;
}

const { project } = Astro.props;

const journalId = project.links?.journalId;
const heroLink = journalId
  ? (
      await defineJournalLinks(
        { hero: journalId },
        { owner: `"${project.title}"` },
      )
    ).hero
  : undefined;

if (heroLink) {
  assertProjectJournalLink(heroLink, project.title);
}

const journalHref = heroLink?.href;
const vault = heroLink?.vaultId ? vaultsManifest[heroLink.vaultId] : undefined;

const siteManifest = buildSiteManifest(project);
---

<BaseLayout siteManifest={siteManifest} image={project.image}>
  <ProjectHero slot="hero" project={project} journalHref={journalHref} />

  <FlexShell class="flex flex-col gap-20 md:gap-28 lg:gap-32">
    <slot />
    {vault && <ProjectVaultSection vault={vault} />}
  </FlexShell>
</BaseLayout>


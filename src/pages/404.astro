---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import SVGIcon from "@components/ui/SVGIcon.astro";
import { ui } from "@data/icons";
---

<BaseLayout pageTitle="404 - Page Not Found">
  <main
    class="relative flex flex-col items-center justify-center min-h-dvh px-8 text-center bg-base-100 overflow-hidden isolate"
  >
    <div
      class="bg-text-outline absolute inset-0 flex items-center justify-center select-none pointer-events-none -z-10 font-black text-[40vw] leading-none opacity-10"
      aria-hidden="true"
    >
      404
    </div>

    <div class="space-y-10 max-w-xl relative z-10">
      <div class="space-y-4">
        <span
          class="inline-block text-base-content font-mono text-xs tracking-[0.4em] uppercase py-1 px-4 border border-base-content/20 rounded-full"
        >
          Error Not Found
        </span>

        <h1
          class="text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter text-base-content"
        >
          Lost in Space
        </h1>

        <p
          class="text-lg md:text-xl text-base-content/70 leading-relaxed max-w-sm mx-auto font-medium"
        >
          The page you are looking for has been moved or doesn't exist in this
          dimension.
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row gap-6 justify-center items-center pt-4"
      >
        <Button
          href="/"
          label="Return to Base"
          variant="btn-primary"
          class="min-w-55 h-14 text-base font-bold shadow-none border-2 border-base-content bg-base-content text-base-100 hover:bg-transparent hover:text-base-content transition-all"
        />

        <button
          onclick="history.back()"
          class="group flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-base-content/60 transition-colors py-2"
        >
          <SVGIcon
            icon={ui.arrowLeft}
            class="size-4 transition-transform group-hover:-translate-x-2"
          />
          Go Back
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

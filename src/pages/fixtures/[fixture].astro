---
import Article from "@components/thejournal/article/Article.astro";
import Callout from "bloomwright-ui/components/display/Callout.astro";
import List, { type ListItem } from "bloomwright-ui/components/display/List.astro";
import MockupBrowser from "bloomwright-ui/components/display/MockupBrowser.astro";
import MockupPhone from "bloomwright-ui/components/display/MockupPhone.astro";
import MockupWindow from "bloomwright-ui/components/display/MockupWindow.astro";
import EChart from "bloomwright-ui/components/render/EChart.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import browserPreview from "@assets/thejournal/pub/sinpluma_03.png";
import mobilePreview from "@assets/thejournal/pub/sinpluma_08.png";
import windowPreview from "@assets/thejournal/pub/sinpluma_01.png";
import {
  barChartOption,
  heatmapChartOption,
  lineChartOption,
  pieChartOption,
} from "bloomwright-ui/echarts";
import { Image } from "astro:assets";

export function getStaticPaths() {
  if (process.env.ALBERTODURAN_TEST_MODE !== "true") return [];

  return ["charts", "components"].map((fixture) => ({
    params: { fixture },
  }));
}

const fixture = Astro.params.fixture;

const siteManifest = {
  description: "Test-only ECharts fixture page.",
  pageTitle: "ECharts Fixture",
  label: "ECharts Fixture",
};

const revenueOption = lineChartOption({
  title: "Quarterly revenue",
  x: ["Q1", "Q2", "Q3", "Q4"],
  y: [12.4, 14.2, 16.1, 18.7],
  name: "Revenue",
  area: true,
});

const enhancedOption = barChartOption({
  title: "Build output",
  x: ["HTML", "CSS", "JS"],
  y: [42, 18, 7],
  name: "Kilobytes",
});

const donutOption = pieChartOption({
  title: "Coverage",
  name: "Coverage",
  donut: true,
  data: [
    { name: "Unit", value: 48 },
    { name: "E2E", value: 22 },
    { name: "Manual", value: 12 },
  ],
});

const externalOption = lineChartOption({
  title: "External artifact",
  x: ["A", "B", "C"],
  y: [3, 5, 4],
  name: "Value",
});

const mediaOption = heatmapChartOption({
  title: "Media enhancement",
  x: ["A", "B"],
  y: ["One", "Two"],
  data: [
    [0, 0, 1],
    [1, 0, 2],
    [0, 1, 3],
    [1, 1, 4],
  ],
});

const componentItems: ListItem[] = [
  {
    title: "Callouts",
    description: "Semantic editorial notices.",
    media: { kind: "marker", label: "01" },
  },
  {
    title: "Lists",
    description: "Structured publication inventories.",
    media: { kind: "marker", label: "02" },
    action: {
      label: "Docs",
      href: "https://daisyui.com/components/list/",
      ariaLabel: "Open the DaisyUI list documentation in a new tab",
      external: true,
    },
  },
  {
    title: "Mockups",
    description: "Static browser, phone, and window frames.",
    media: { kind: "marker", label: "03" },
  },
];
---

<BaseLayout siteManifest={siteManifest}>
  <div class="py-8 px-4">
    <Article>
      {
        fixture === "charts" ? (
          <Fragment>
            <h1>ECharts Fixture</h1>

            <EChart
        id="static-chart"
        title="Quarterly revenue"
        caption="Static SVG baseline"
        description="Line chart showing quarterly revenue increasing from Q1 to Q4."
        option={revenueOption}
        width={760}
        height={420}
            />

            <EChart
        id="enhanced-chart"
        title="Build output"
        caption="Enhanced on page load"
        description="Bar chart comparing generated HTML, CSS, and JavaScript output."
        option={enhancedOption}
        clientOption={enhancedOption}
        width={760}
        height={420}
        enhance="load"
            />

            <EChart
        id="donut-chart"
        title="Coverage"
        caption="Second static chart"
        description="Donut chart showing coverage split across unit, E2E, and manual checks."
        option={donutOption}
        width={640}
        height={420}
            />

            <EChart
        id="external-chart"
        title="External artifact"
        caption="Static chart emitted as a hashed SVG asset"
        description="Line chart rendered as an external SVG artifact."
        option={externalOption}
        width={640}
        height={360}
        render="svg-file"
        cacheKey="fixture-external-chart"
            />

            <EChart
        id="media-chart"
        title="Media enhancement"
        caption="Enhanced only when the media query matches"
        description="Heatmap chart enhanced only on wider viewports."
        option={mediaOption}
        clientOption={mediaOption}
        width={640}
        height={360}
        hydrate="media"
        media="(min-width: 900px)"
            />
          </Fragment>
        ) : (
          <Fragment>
            <h1>Publication Components Fixture</h1>

            <List
              items={componentItems}
              aria-label="Publication component inventory"
            />

            <Callout variant="note"><p>Remember the editorial context.</p></Callout>
            <Callout variant="information" title="Build context"><p>Generated during the deterministic test build.</p></Callout>
            <Callout variant="warning"><ul><li>Check content</li><li>Check layout</li><li>Check links</li></ul></Callout>
            <Callout
              variant="caution"
              title="Custom editorial checkpoint"
              data-gallery-callout="custom-palette"
              palette={{ iconSurface: "color-mix(in oklab, var(--color-warning) 25%, transparent)" }}
            ><p>Review the palette in both themes.</p></Callout>
            <Callout variant="error"><pre>schema_identifier_too_long</pre></Callout>

            <MockupBrowser
              url="https://albertoduran.com/thejournal/sin_pluma/"
              aria-label="Production publication browser screenshot"
            >
              <Image src={browserPreview} alt="Publication browser preview" draggable={false} />
              <span slot="caption">A production-style route rendered as static media.</span>
            </MockupBrowser>

            <MockupBrowser aria-label="Local publication preview browser state">
              <div slot="toolbar" class="flex w-full items-center gap-3 px-3">
                <strong>Preview</strong>
                <span>localhost:4321/thejournal/component-gallery</span>
                <button type="button" data-browser-demo-control>Refresh</button>
              </div>
              <div class="p-6">Local preview content</div>
            </MockupBrowser>

            <MockupPhone aria-label="Mobile publication screenshot">
              <Image src={mobilePreview} alt="Mobile publication preview" draggable={false} />
            </MockupPhone>

            <h2 id="gallery-window-preview-title">Window publication screenshot</h2>
            <MockupWindow aria-labelledby="gallery-window-preview-title">
              <Image src={windowPreview} alt="Window publication preview" draggable={false} />
            </MockupWindow>
          </Fragment>
        )
      }
    </Article>
  </div>
</BaseLayout>

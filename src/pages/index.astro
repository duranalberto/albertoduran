---
import image from "@assets/thejournal/stock/10.jpg";
import AtlasNote from "@components/index/AtlasNote.astro";
import IndexHero from "@components/index/IndexHero.astro";
import ProfileView from "@components/index/ProfileView.astro";
import Quote from "@components/index/Quote.astro";
import JournalGrid from "@components/shared/JournalGrid.astro";
import ProjectsGrid from "@components/shared/ProjectsGrid.astro";
import { entryManifest } from "@content/processors/thejournal";
import { resolveFeaturedPublications } from "@data/featured_publications";
import { sitesManifest } from "@data/site_manifest";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";
import SectionHeader from "bloomwright-ui/components/display/SectionHeader.astro";
import OverlayPanel from "bloomwright-ui/components/primitive/OverlayPanel.astro";

const catalog = resolveFeaturedPublications(entryManifest);

const atlasNoteToggleId = "atlas-story-modal";
---

<BaseLayout siteManifest={sitesManifest["/"]} image={image}>
  <IndexHero slot="hero" />

  <div class="flex flex-col gap-20">
    <ProfileView />

    <FlexShell>
      <SectionHeader
        title="Featured Projects"
        linkHref="/projects/"
        linkLabel="Browse all projects"
      />
      <ProjectsGrid />
    </FlexShell>

    <FlexShell>
      <SectionHeader
        title="Starred Publications"
        linkHref="/thejournal/"
        linkLabel="Read more in theJournal."
      />
      <JournalGrid catalog={catalog} />
    </FlexShell>

    <Quote />
  </div>

  <Fragment slot="overlays">
    <OverlayPanel
      toggleId={atlasNoteToggleId}
      ariaLabel="Atlas championship story"
      closeLabel="Close Atlas story"
      maxWidthClass="sm:max-w-2xl"
      boxClass="atlas-note-panel"
      scrollClass="atlas-note-scroll"
    >
      <AtlasNote />
    </OverlayPanel>
  </Fragment>
</BaseLayout>

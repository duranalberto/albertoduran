---
import { type EntryContext } from "@appTypes/content_context";
import image from "@assets/thejournal/stock/10.jpg";
import AtlasNote from "@components/index/AtlasNote.astro";
import IndexHero from "@components/index/IndexHero.astro";
import ProfileView from "@components/index/ProfileView.astro";
import Quote from "@components/index/Quote.astro";
import JournalGrid from "@components/shared/JournalGrid.astro";
import ProjectsGrid from "@components/shared/ProjectsGrid.astro";
import { entryManifest } from "@content/processors/thejournal";
import { sitesManifest } from "@data/site_manifest";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";
import SectionHeader from "bloomwright-ui/components/display/SectionHeader.astro";
import OverlayPanel from "bloomwright-ui/components/primitive/OverlayPanel.astro";

const publications: Set<string> = new Set([
  "siliconboutique",
  "langchain_ollama",
  "aws_serverless_vod",
]);

const manifestMap = new Map(
  Object.values(entryManifest).map((entry) => [entry.id, entry]),
);

const catalog = Array.from(publications)
  .map((id) => manifestMap.get(id))
  .filter((entry): entry is EntryContext => !!entry);

const atlasNoteToggleId = "atlas-story-modal";
const untitledOverlayTestToggleId = "untitled-overlay-test-modal";
const isTestMode = process.env.ALBERTODURAN_TEST_MODE === "true";
---

<BaseLayout siteManifest={sitesManifest["/"]} image={image}>
  <IndexHero slot="hero" />

  <div class="flex flex-col gap-20">
    <ProfileView />

    <FlexShell>
      <SectionHeader title="Featured Projects" />
      <ProjectsGrid />
    </FlexShell>

    <FlexShell>
      <SectionHeader
        title="Starred Publications"
        linkHref="/thejournal/"
        linkLabel="Read more in theJournal."
      />
      <JournalGrid catalog={catalog} />
    </FlexShell>

    <Quote />

    {
      isTestMode && (
        <FlexShell>
          <label
            for={untitledOverlayTestToggleId}
            role="button"
            tabindex="0"
            aria-haspopup="dialog"
            class="btn btn-sm"
          >
            Open untitled overlay test
          </label>
        </FlexShell>
      )
    }
  </div>

  <Fragment slot="overlays">
    <OverlayPanel
      toggleId={atlasNoteToggleId}
      ariaLabel="Atlas championship story"
      closeLabel="Close Atlas story"
      maxWidthClass="sm:max-w-2xl"
      boxClass="atlas-note-panel"
      scrollClass="atlas-note-scroll"
    >
      <AtlasNote />
    </OverlayPanel>

    {
      isTestMode && (
        <OverlayPanel
          toggleId={untitledOverlayTestToggleId}
          ariaLabel="Untitled overlay test"
          closeLabel="Close untitled overlay test"
          maxWidthClass="sm:max-w-lg"
        >
          <div class="space-y-6" data-untitled-overlay-body>
            <p>Untitled overlay body starts at the top of the panel.</p>
            {Array.from({ length: 24 }, (_, index) => (
              <p>
                Scroll fixture row {index + 1}: enough content to verify the
                floating close button stays anchored while the panel body
                scrolls.
              </p>
            ))}
          </div>
        </OverlayPanel>
      )
    }
  </Fragment>
</BaseLayout>

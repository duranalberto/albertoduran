---
import { type EntryContext } from "@appTypes/content_context";
import AtlasStats from "@components/index/AtlasStats.astro";
import IndexHero from "@components/index/IndexHero.astro";
import ProfileView from "@components/index/ProfileView.astro";
import Quote from "@components/index/Quote.astro";
import JournalGrid from "@components/shared/JournalGrid.astro";
import ProjectsGrid from "@components/shared/ProjectsGrid.astro";
import SectionHeader from "@components/ui/display/SectionHeader.astro";
import { entryManifest } from "@content/processors/thejournal";
import about from "@data/about";
import { sitesManifest } from "@data/site_manifest";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";

const publications: Set<string> = new Set([
  "siliconboutique",
  "building_albertoduran",
  "building_albertoduran/fasteeer",
]);

const manifestMap = new Map(
  Object.values(entryManifest).map((entry) => [entry.id, entry]),
);

const catalog = Array.from(publications)
  .map((id) => manifestMap.get(id))
  .filter((entry): entry is EntryContext => !!entry);
---

<BaseLayout siteManifest={sitesManifest["/"]}>
  <IndexHero slot="hero" />

  <div class="flex flex-col gap-20 mb-20">
    <ProfileView />

    <FlexShell>
      <SectionHeader title="Projects" />
      <ProjectsGrid projects={about.projects} />
    </FlexShell>

    <AtlasStats />

    <FlexShell>
      <SectionHeader
        title="Starred Publications"
        linkHref="/thejournal/"
        linkLabel="Read more in theJournal."
      />
      <JournalGrid catalog={catalog} />
    </FlexShell>

    <Quote />
  </div>
</BaseLayout>

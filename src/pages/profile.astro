---
import image from "@assets/thejournal/stock/05.avif";
import AwardsGrid from "@components/profile/AwardsGrid.astro";
import CertificationsList from "@components/profile/CertificationsList.astro";
import EducationList from "@components/profile/EducationList.astro";
import ExperienceTimeline from "@components/profile/ExperienceTimeline.astro";
import ProfileHero from "@components/profile/ProfileHero.astro";
import SkillsGrid from "@components/profile/SkillsGrid.astro";
import ProjectsGrid from "@components/shared/ProjectsGrid.astro";
import SectionHeader from "@components/ui/display/SectionHeader.astro";
import about from "@data/about";
import { sitesManifest } from "@data/site_manifest";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";
---

<BaseLayout siteManifest={sitesManifest["/profile/"]} image={image}>
  <ProfileHero slot="hero" />

  <FlexShell class="flex flex-col gap-16 md:gap-24 lg:gap-32 pb-14">
    <section id="skills" class="w-full">
      <SectionHeader title="Technical Skills" />
      <SkillsGrid skills={about.skills} />
    </section>

    <section id="experience" class="w-full">
      <SectionHeader title="Professional Experience" />
      <ExperienceTimeline experience={about.experience} />
    </section>

    <section
      id="credentials"
      class="grid grid-cols-1 gap-16 md:grid-cols-2 lg:gap-24"
    >
      <h2 class="sr-only">Credentials</h2>
      <div class="w-full">
        <SectionHeader title="Educational Background" level={3} />
        <EducationList education={about.education} />
      </div>

      <div class="w-full">
        <SectionHeader title="Professional Certifications" level={3} />
        <CertificationsList certifications={about.certifications} />
      </div>
    </section>

    <section id="awards" class="w-full">
      <SectionHeader title="Honors and Awards" />
      <AwardsGrid awards={about.awards} />
    </section>

    <section id="projects" class="w-full">
      <SectionHeader title="Selected Projects" />
      <ProjectsGrid />
    </section>
  </FlexShell>
</BaseLayout>

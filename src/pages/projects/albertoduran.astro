---
import type { ProjectPageConfig } from "@appTypes/project";
import coverImage from "@assets/thejournal/stock/01.avif";
import Callout from "@components/ui/display/Callout.astro";
import SectionHeader from "@components/ui/display/SectionHeader.astro";
import Steps, { type StepItem } from "@components/ui/display/Steps.astro";
import EChart from "@components/ui/mdx/EChart.astro";
import MermaidDiagram from "@components/ui/mdx/MermaidDiagram.astro";
import { lineChartOption } from "@integrations/echarts/options";
import { defineMermaidDiagram } from "@integrations/mermaid/definition";
import ProjectLayout from "@layouts/ProjectLayout.astro";

const project: ProjectPageConfig = {
  title: "albertoduran.com",
  eyebrow: "Portfolio · Publishing System",
  description:
    "A personal site I began after a layoff so my work would have more room than a résumé or interview, now built as a static-first portfolio and publishing platform.",
  image: coverImage,
  imageAlt: "A bright development workspace with source code open on a laptop",
  facts: [
    { label: "Role", value: "Design & Engineering" },
    { label: "Platform", value: "Astro 6" },
    { label: "Rendering", value: "Static-first" },
    { label: "Delivery", value: "Workers Static Assets" },
  ],
  links: {
    journalId: "building_albertoduran",
  },
};

const productSurfaces = [
  {
    label: "Professional Profile",
    title: "The working history behind the projects",
    description:
      "Experience, skills, and selected work give hiring teams a direct route through the career behind the code.",
    href: "/profile/",
  },
  {
    label: "Project showcases",
    title: "A useful overview before the source tour",
    description:
      "Each landing page explains the problem and the result, then links to the technical record for readers who want the implementation.",
    href: "/projects/albertoduran/",
  },
  {
    label: "The Journal",
    title: "The decisions that do not fit on a project card",
    description:
      "Standalone articles and structured vaults document architecture, debugging work, tradeoffs, and contributor boundaries.",
    href: "/thejournal/",
  },
  {
    label: "Technical media",
    title: "Diagrams and charts stay close to their source",
    description:
      "Mermaid and ECharts produce static SVG during the build, so technical visuals remain part of the article when JavaScript is off.",
    href: "/thejournal/building_albertoduran/echarts/",
  },
];

const architectureHighlights = [
  {
    marker: "01",
    title: "Content becomes routes before deployment",
    description:
      "Collections validate MDX, the manifest applies publication rules, and Astro generates every known article route before deployment.",
    href: "/thejournal/building_albertoduran/publications/static_generation/",
  },
  {
    marker: "02",
    title: "Visual explanations arrive as static assets",
    description:
      "Mermaid diagrams and ECharts figures render during the build. The browser receives useful SVG before any optional interaction starts.",
    href: "/thejournal/building_albertoduran/mermaid/pipeline/",
  },
  {
    marker: "03",
    title: "Runtime code stays deliberately narrow",
    description:
      "Theme persistence, overlays, and article navigation improve complete HTML instead of becoming prerequisites for reading it.",
    href: "/thejournal/building_albertoduran/runtime/",
  },
  {
    marker: "04",
    title: "Production receives finished work",
    description:
      "Workers Static Assets serves the generated file graph. It does not need to understand MDX, vault rules, or page assembly.",
    href: "/thejournal/building_albertoduran/foundations/cloudflare_deployment/",
  },
];

const publishingCapabilities = [
  {
    title: "Typed content and visible publishing rules",
    description:
      "Schemas and manifest tests catch malformed metadata, draft leaks, missing images, and broken vault structure before routing begins.",
    href: "/thejournal/building_albertoduran/publications/manifest_rules/",
  },
  {
    title: "Directory-driven vault navigation",
    description:
      "Folders become ordered reading paths with nested sections, breadcrumbs, responsive navigation, and previous or next links from one model.",
    href: "/thejournal/building_albertoduran/publications/collections/",
  },
  {
    title: "MDX with a controlled component vocabulary",
    description:
      "Articles can use editorial components, diagrams, charts, code, and tables while keeping typography and static output consistent.",
    href: "/thejournal/building_albertoduran/publications/mdx_rendering/",
  },
];

const readerExperience = [
  {
    title: "Theme continuity without a flash",
    description:
      "An inline bootstrap applies the initial preference, while a small manager preserves it across Astro route swaps.",
    href: "/thejournal/building_albertoduran/runtime/theme_system/",
  },
  {
    title: "Navigation that respects the reading surface",
    description:
      "Vault explorers, heading tracking, pagination, and mobile overlays adapt without making the article depend on client rendering.",
    href: "/thejournal/building_albertoduran/runtime/on_this_page/",
  },
  {
    title: "Images and fonts prepared ahead of time",
    description:
      "Astro prepares responsive image variants and registered fonts during the build, with selected preloads for the first reading surface.",
    href: "/thejournal/building_albertoduran/performance/image_and_font_strategy/",
  },
  {
    title: "Generated output receives a final pass",
    description:
      "Vite bundles assets, the HTML minifier protects code fragments, and the build emits inspectable files for deployment.",
    href: "/thejournal/building_albertoduran/performance/file_optimization/",
  },
];

const deliverySteps: StepItem[] = [
  { label: "Validate source", marker: "1", color: "success" },
  { label: "Resolve content", marker: "2", color: "success" },
  { label: "Render assets", marker: "3", color: "success" },
  { label: "Test output", marker: "4", color: "success" },
  { label: "Deliver files", marker: "5", color: "success" },
];

const samplePublicationTrend = lineChartOption({
  title: "Sample publication trend",
  subtitle: "Illustrative data",
  x: ["Issue 1", "Issue 2", "Issue 3", "Issue 4"],
  y: [120, 180, 165, 240],
  name: "Example reads",
  smooth: true,
  area: true,
});

const buildFlow = defineMermaidDiagram(String.raw`
flowchart LR
    Source["📝 Astro, MDX, and typed data"] --> Resolve["🧭 Collections and manifests"]
    Resolve --> Build["⚙️ Build integrations"]
    Build --> Output["📦 HTML, CSS, images, charts, and SVG"]
    Output --> Edge["☁️ Cloudflare edge delivery"]
    Edge --> Reader["👤 Readable page"]
    Reader -. "optional enhancement" .-> Runtime["✨ Theme, overlays, and navigation"]

    classDef source fill:#FFE4B5,stroke:#333,stroke-width:2px,color:#000
    classDef process fill:#90EE90,stroke:#333,stroke-width:2px,color:#064E3B
    classDef output fill:#E6E6FA,stroke:#333,stroke-width:2px,color:#1E3A8A
    classDef delivery fill:#87CEEB,stroke:#333,stroke-width:2px,color:#0F172A
    classDef reader fill:#FFD700,stroke:#333,stroke-width:2px,color:#000

    class Source source
    class Resolve,Build process
    class Output output
    class Edge,Runtime delivery
    class Reader reader
`);

const staticVisualFlow = defineMermaidDiagram(String.raw`
flowchart LR
    Mermaid["📝 Mermaid source"] --> MermaidBuild["⚙️ Mermaid integration"]
    Chart["📊 ECharts option"] --> ChartBuild["⚙️ Server renderer"]
    MermaidBuild --> Diagram["🖼️ Diagram SVG"]
    ChartBuild --> Figure["📈 Chart SVG"]
    Diagram --> Page["📄 Generated HTML"]
    Figure --> Page
    Page --> Reader["👤 Readable with JavaScript off"]
    Reader -. "optional" .-> Enhance["✨ Browser interaction"]

    classDef source fill:#FFE4B5,stroke:#333,stroke-width:2px,color:#000
    classDef build fill:#90EE90,stroke:#333,stroke-width:2px,color:#064E3B
    classDef output fill:#87CEEB,stroke:#333,stroke-width:2px,color:#0F172A
    classDef reader fill:#E6E6FA,stroke:#333,stroke-width:2px,color:#1E3A8A

    class Mermaid,Chart source
    class MermaidBuild,ChartBuild build
    class Diagram,Figure,Page output
    class Reader,Enhance reader
`);
---

<ProjectLayout project={project}>
  <section id="overview" class="w-full" aria-labelledby="overview-title">
    <SectionHeader
      id="overview-title"
      title="More room than an interview"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-5 lg:col-span-7">
        <p class="text-xl leading-relaxed text-base-content md:text-2xl">
          I started albertoduran.com after I was laid off. A résumé can list
          experience, but it cannot show much of how I think or build, and a
          short interview rarely leaves enough time to walk through the work
          properly.
        </p>
        <p
          class="max-w-3xl text-base leading-relaxed text-base-content/70 md:text-lg"
        >
          What began as a personal introduction grew into a portfolio, a set of
          project case studies, and a place for all kinds of writing. Astro
          resolves the content, routes, diagrams, charts, and responsive images
          before deployment, so the site itself can demonstrate the engineering
          choices I want readers and hiring teams to inspect.
        </p>
      </div>

      <Callout
        variant="information"
        title="What visitors can find here"
        class="lg:col-span-5"
      >
        <p>
          The site brings my experience, projects, and writing into one place.
          Visitors can get a quick introduction or spend more time reading how
          I approached and built each project.
        </p>
      </Callout>
    </div>
  </section>

  <section
    id="product-surfaces"
    class="w-full"
    aria-labelledby="product-surfaces-title"
  >
    <SectionHeader
      id="product-surfaces-title"
      title="Choose how deep to read"
    />

    <p class="mb-10 max-w-4xl text-lg leading-relaxed text-base-content/75">
      Visitors arrive with different amounts of time and curiosity. They can
      scan the profile, open a project overview, read one focused article, or
      follow a complete architecture vault without moving to a separate product.
    </p>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        productSurfaces.map((surface) => (
          <a
            href={surface.href}
            class="group card card-border h-full bg-base-200 text-base-content shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <article class="card-body gap-4">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
                {surface.label}
              </p>
              <h3 class="card-title font-display text-xl transition-colors group-hover:text-primary">
                {surface.title}
              </h3>
              <p class="grow leading-relaxed text-base-content/70">
                {surface.description}
              </p>
              <span class="text-sm font-bold text-primary">
                See this surface &rarr;
              </span>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section id="build-flow" class="w-full" aria-labelledby="build-flow-title">
    <SectionHeader id="build-flow-title" title="From source to reader" />

    <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-end">
      <p class="text-lg leading-relaxed text-base-content/75">
        Source files move through named ownership boundaries. Collections and
        manifests decide what publishes, integrations handle visual rendering,
        Astro emits the complete file graph, and Workers Static Assets serves
        it. The browser starts with a useful document.
      </p>
      <p class="text-base leading-relaxed text-base-content/65">
        The separation gives each failure a smaller search area. A broken
        runtime control can be debugged without treating the content manifest or
        generated page as the same problem.
      </p>
    </div>

    <MermaidDiagram code={buildFlow} />
  </section>

  <section
    id="static-visuals"
    class="w-full"
    aria-labelledby="static-visuals-title"
  >
    <SectionHeader
      id="static-visuals-title"
      title="The browser can take the day off"
    />

    <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <p class="text-xl leading-relaxed text-base-content lg:col-span-7">
        Both examples below are SVG produced during the build. The Mermaid fence
        travels through the diagram integration, while the ECharts option uses
        the server renderer. Neither visual waits for client-side JavaScript to
        become readable.
      </p>
      <Callout
        variant="information"
        title="Try the blunt test"
        class="lg:col-span-5"
      >
        <p>
          Disable JavaScript and reload this page. The diagram and chart remain.
          JavaScript is reserved for optional controls such as diagram expansion
          or an explicitly hydrated chart.
        </p>
      </Callout>
    </div>

    <div class="grid grid-cols-1 gap-8 xl:grid-cols-2 xl:items-start">
      <article class="min-w-0">
        <h3 class="mb-3 font-display text-2xl font-semibold text-base-content">
          Mermaid source becomes a static diagram
        </h3>
        <p class="mb-4 leading-relaxed text-base-content/70">
          This flow is stored as readable Mermaid text in the repository. The
          build converts it into themed SVG and places the result in the page.
        </p>
        <MermaidDiagram code={staticVisualFlow} />
      </article>

      <article class="min-w-0">
        <h3 class="mb-3 font-display text-2xl font-semibold text-base-content">
          ECharts renders before hydration
        </h3>
        <p class="mb-4 leading-relaxed text-base-content/70">
          This chart uses an illustrative dataset and the same EChart component
          available to journal authors. No hydration mode is set, so the output
          stays a static SVG by design.
        </p>
        <EChart
          id="project-static-publication-trend"
          title="Sample publication trend"
          caption="Illustrative data rendered as static SVG"
          description="Illustrative line chart whose sample values rise from 120 in Issue 1 to 240 in Issue 4, with a dip at Issue 3."
          option={samplePublicationTrend}
          width={760}
          height={420}
        />
      </article>
    </div>
  </section>

  <section
    id="architecture"
    class="w-full"
    aria-labelledby="architecture-title"
  >
    <SectionHeader
      id="architecture-title"
      title="Decisions that shape the experience"
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        architectureHighlights.map((item) => (
          <a
            href={item.href}
            class="group card card-border h-full bg-base-100 text-base-content shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <article class="card-body gap-5">
              <span
                class="font-mono text-sm font-bold text-primary"
                aria-hidden="true"
              >
                {item.marker}
              </span>
              <h3 class="card-title font-display text-xl transition-colors group-hover:text-primary">
                {item.title}
              </h3>
              <p class="grow leading-relaxed text-base-content/70">
                {item.description}
              </p>
              <span class="text-sm font-bold text-primary">
                Read the implementation detail &rarr;
              </span>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section
    id="publishing-system"
    class="w-full"
    aria-labelledby="publishing-system-title"
  >
    <SectionHeader
      id="publishing-system-title"
      title="The Journal has publication rules"
    />

    <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <p class="text-xl leading-relaxed text-base-content lg:col-span-7">
        An article enters the site as MDX, then the publication manifest gives
        it a route, navigation context, breadcrumbs, and a place in the reading
        sequence. Authors work with content while the build applies those rules.
      </p>
      <Callout variant="note" title="Where policy lives" class="lg:col-span-5">
        <p>
          The schema validates frontmatter, while the manifest owns filesystem
          policy. Keeping those jobs separate makes errors easier to locate.
        </p>
      </Callout>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        publishingCapabilities.map((capability) => (
          <a
            href={capability.href}
            class="group rounded-box border border-base-300 bg-base-100 p-6 text-base-content shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <h3 class="mb-3 font-display text-xl font-semibold transition-colors group-hover:text-primary">
              {capability.title}
            </h3>
            <p class="mb-5 leading-relaxed text-base-content/70">
              {capability.description}
            </p>
            <span class="text-sm font-bold text-primary">
              Follow the publishing detail &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section
    id="reader-experience"
    class="w-full"
    aria-labelledby="reader-experience-title"
  >
    <SectionHeader
      id="reader-experience-title"
      title="A complete page before enhancement"
    />

    <p class="mb-10 max-w-4xl text-lg leading-relaxed text-base-content/75">
      The browser receives a complete document first. It then handles facts the
      build cannot know, including the reader's theme preference, viewport,
      focus position, scroll state, and local timezone.
    </p>

    <div class="grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
      {
        readerExperience.map((feature) => (
          <a
            href={feature.href}
            class="group flex gap-5 border-t border-base-300 pt-6 text-base-content focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            <span
              class="mt-1 block size-2 shrink-0 rounded-full bg-primary"
              aria-hidden="true"
            />
            <span>
              <strong class="font-display text-lg transition-colors group-hover:text-primary">
                {feature.title}
              </strong>
              <span class="mt-2 block leading-relaxed text-base-content/70">
                {feature.description}
              </span>
              <span class="mt-3 block text-sm font-bold text-primary">
                Read the design decision &rarr;
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="delivery" class="w-full" aria-labelledby="delivery-title">
    <SectionHeader id="delivery-title" title="From validation to deployment" />

    <Steps
      items={deliverySteps}
      aria-label="Static site delivery sequence"
      class="mb-10 w-full"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div>
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Tests follow the failure boundary
        </h3>
        <p class="text-base leading-relaxed text-base-content/70 md:text-lg">
          Astro diagnostics protect source and content shapes. Vitest covers
          manifest rules, SVG transforms, charts, loaders, and minification. A
          deterministic production build replaces unstable outside inputs, and
          Playwright checks selected reader behavior in Chromium.
        </p>
      </div>

      <div>
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Hosting serves the finished file graph
        </h3>
        <p class="text-base leading-relaxed text-base-content/70 md:text-lg">
          Production receives complete routes, metadata, fonts, images, themed
          diagrams, chart SVG, CSS, and runtime modules. Workers Static Assets
          serves that file graph without assembling journal pages per request.
        </p>
      </div>
    </div>

    <Callout variant="warning" title="Evidence still to add" class="mt-10">
      <p>
        The repository has no Lighthouse or Web Vitals baseline, and the build
        budget is a JavaScript guardrail rather than a field performance
        measurement. Browser coverage is Chromium-only and does not include Axe
        or a documented screen-reader audit.
      </p>
    </Callout>
  </section>

  <section
    id="outcomes"
    class="overflow-hidden rounded-box bg-primary text-primary-content shadow-xl"
    aria-labelledby="outcomes-title"
  >
    <div
      class="grid grid-cols-1 gap-10 p-8 md:p-12 lg:grid-cols-12 lg:items-center lg:p-16"
    >
      <div class="lg:col-span-7">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] opacity-70">
          The outcome
        </p>
        <h2
          id="outcomes-title"
          class="font-display text-3xl font-bold leading-tight sm:text-4xl"
        >
          One site connects who I am, what I have built, and how I work.
        </h2>
      </div>

      <ul
        class="flex flex-col gap-4 lg:col-span-5"
        aria-label="Project outcomes"
      >
        <li class="flex gap-3 border-b border-primary-content/20 pb-4">
          <span aria-hidden="true">✓</span>
          <span>
            Hiring teams get a concise professional overview with technical
            evidence close at hand.
          </span>
        </li>
        <li class="flex gap-3 border-b border-primary-content/20 pb-4">
          <span aria-hidden="true">✓</span>
          <span>
            Developers can learn from the architecture, tradeoffs, diagrams, and
            tests behind a working project.
          </span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true">✓</span>
          <span>
            The portfolio and journal remain useful with JavaScript disabled,
            including their technical visuals.
          </span>
        </li>
      </ul>
    </div>
  </section>
</ProjectLayout>

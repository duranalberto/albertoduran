---
import type { ProjectPageConfig } from "@appTypes/project";
import coverImage from "@assets/thejournal/stock/06.avif";
import EquityValuationFlow from "@components/projects/EquityValuationFlow.mdx";
import Callout from "@components/ui/display/Callout.astro";
import SectionHeader from "@components/ui/display/SectionHeader.astro";
import Steps, { type StepItem } from "@components/ui/display/Steps.astro";
import MermaidDiagramWrapper from "@components/ui/mdx/MermaidDiagramWrapper.astro";
import ProjectLayout from "@layouts/ProjectLayout.astro";

const project: ProjectPageConfig = {
  title: "Equity Valuation Engine",
  eyebrow: "Finance · Decision Support",
  description:
    "A Python engine I built to evaluate companies more deliberately as I expand my portfolio, with model fit, assumptions, and uncertainty kept beside every estimate.",
  image: coverImage,
  imageAlt:
    "A financial market chart with candlesticks and trend lines on a dark display",
  facts: [
    { label: "Interface", value: "CLI · JSON" },
    { label: "Data", value: "yfinance" },
    { label: "Methods", value: "DCF · Multiples · NAV" },
    { label: "Analysis", value: "Bear · Base · Bull" },
  ],
  links: {
    githubUrl: "https://github.com/duranalberto/equity-valuation-engine",
    journalId: "equity_valuation_engine",
  },
};

const foundations = [
  {
    marker: "01",
    title: "Run a valuation before studying the formulas",
    description:
      "Start with the CLI, learn the output order, and see why a skipped model can be more useful than another per-share estimate.",
    href: "/thejournal/equity_valuation_engine/first_valuation_run/",
  },
  {
    marker: "02",
    title: "Choose a model that fits the business",
    description:
      "Match cash flow, earnings, revenue, dividends, returns, and assets to the question each valuation method can answer.",
    href: "/thejournal/equity_valuation_engine/choosing_a_valuation_model/",
  },
  {
    marker: "03",
    title: "Check the inputs behind the result",
    description:
      "Follow provider fields into StockMetrics, inspect selected missing-value reasons, and understand the currency boundary that still needs work.",
    href: "/thejournal/equity_valuation_engine/trusting_the_inputs/",
  },
];

const modelFamilies = [
  {
    label: "Cash flow",
    title: "DCF and Reverse DCF",
    description:
      "Forward DCF estimates intrinsic value from projected cash flows; Reverse DCF asks what growth the current market price already assumes.",
  },
  {
    label: "Market comparison",
    title: "P/E, EV/EBITDA, and P/S",
    description:
      "Comparable-value models use earnings, operating performance, revenue, and configured multiples without pretending one method fits every business.",
  },
  {
    label: "Business structure",
    title: "ROE, DDM, and NAV",
    description:
      "Return, dividend, and asset-based models help when cash-flow or market-multiple approaches do not fit the business well.",
  },
];

const valuationSteps: StepItem[] = [
  { label: "Normalize", marker: "1", color: "success" },
  { label: "Diagnose", marker: "2", color: "success" },
  { label: "Qualify", marker: "3", color: "success" },
  { label: "Value", marker: "4", color: "success" },
  { label: "Explain", marker: "5", color: "success" },
];

const mermaidComponents = { div: MermaidDiagramWrapper };
---

<ProjectLayout project={project}>
  <section id="overview" class="w-full" aria-labelledby="overview-title">
    <SectionHeader
      id="overview-title"
      title="A more disciplined way to invest"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-5 lg:col-span-7">
        <p class="text-xl leading-relaxed text-base-content md:text-2xl">
          I had invested conservatively for years and earned good returns, but I
          wanted to expand my portfolio without relying on a promising ticker or
          a single familiar ratio. I needed a repeatable way to ask whether a
          company looked fairly valued or undervalued.
        </p>
        <p class="max-w-3xl text-base leading-relaxed text-base-content/70 md:text-lg">
          The engine grew from that need. It turns one ticker into several
          valuation arguments, records weak or missing data, and checks whether
          each model belongs in the analysis before it runs. It cannot remove
          the risk of investing, but making larger decisions without that
          discipline would leave me with even less to challenge.
        </p>
      </div>

      <Callout
        variant="information"
        title="What it helps me understand"
        class="lg:col-span-5"
      >
        <p>
          The engine lets me compare several estimates for one company and see
          why they differ. It does not tell me what to buy, but it gives me more
          information to question before I invest.
        </p>
      </Callout>
    </div>
  </section>

  <section
    id="valuation-flow"
    class="w-full"
    aria-labelledby="valuation-flow-title"
  >
    <SectionHeader
      id="valuation-flow-title"
      title="From ticker symbol to valuation report"
    />
    <p class="mb-8 max-w-4xl text-lg leading-relaxed text-base-content/75">
      The pipeline separates data loading, domain modeling, model policy,
      calculation, and presentation. Each layer passes a structured result to
      the next one instead of quietly repeating earlier work.
    </p>
    <EquityValuationFlow components={mermaidComponents} />
  </section>

  <section
    id="analytical-foundations"
    class="w-full"
    aria-labelledby="analytical-foundations-title"
  >
    <SectionHeader
      id="analytical-foundations-title"
      title="Start with the result, then inspect the evidence"
    />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        foundations.map((item) => (
          <a
            href={item.href}
            aria-label={`Read ${item.title}`}
            class="group card card-border h-full bg-base-100 text-base-content shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <article class="card-body gap-5">
              <span class="font-mono text-sm font-bold text-primary" aria-hidden="true">
                {item.marker}
              </span>
              <h3 class="card-title font-display text-xl transition-colors group-hover:text-primary">
                {item.title}
              </h3>
              <p class="grow leading-relaxed text-base-content/70">
                {item.description}
              </p>
              <span class="text-sm font-bold text-primary">
                Read this publication &rarr;
              </span>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section id="models" class="w-full" aria-labelledby="models-title">
    <SectionHeader id="models-title" title="Different models answer different questions" />

    <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <p class="text-xl leading-relaxed text-base-content lg:col-span-7">
        Cash flow, earnings, revenue, dividends, returns, and net assets describe
        different parts of a business. The engine runs each method through the
        same manager contract without pretending their answers should agree.
      </p>
      <Callout variant="note" title="Why Reverse DCF stays separate" class="lg:col-span-5">
        <p>
          Reverse DCF stays outside the composite value. It explains the growth
          implied by the market price rather than voting on intrinsic value.
        </p>
      </Callout>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        modelFamilies.map((family) => (
          <article class="rounded-box border border-base-300 bg-base-200 p-6 text-base-content shadow-sm">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-primary">
              {family.label}
            </p>
            <h3 class="mb-3 font-display text-xl font-semibold">{family.title}</h3>
            <p class="leading-relaxed text-base-content/70">{family.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
      <a
        href="/thejournal/equity_valuation_engine/dcf_and_reverse_dcf/"
        class="inline-flex font-bold text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Work through DCF and Reverse DCF &rarr;
      </a>
      <a
        href="/thejournal/equity_valuation_engine/other_valuation_models/"
        class="inline-flex font-bold text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Compare the other valuation models &rarr;
      </a>
    </div>
  </section>

  <section id="scenarios" class="w-full" aria-labelledby="scenarios-title">
    <SectionHeader id="scenarios-title" title="Assumptions remain part of the output" />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="mb-5 text-xl leading-relaxed text-base-content">
          Growth does not enter a formula as one unexplained percentage. The
          engine selects a signal, records its source, constrains unstable
          values, and builds Bear, Base, and Bull paths for models that need
          projections.
        </p>
        <p class="leading-relaxed text-base-content/70">
          Optional weighted blending and sector mean reversion remain explicit.
          When evidence is too thin for the richer path, the system falls back
          and records why.
        </p>
      </div>
      <a
        href="/thejournal/equity_valuation_engine/assumptions_and_scenarios/"
        class="group rounded-box border border-base-300 bg-primary p-8 text-primary-content shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] opacity-70">
          Scenario engine
        </p>
        <h3 class="mb-3 font-display text-2xl font-semibold">
          See how signals become projections
        </h3>
        <p class="leading-relaxed opacity-80">
          See how selection, clamping, scenario adjustments, and mean reversion
          become a growth path you can inspect.
        </p>
        <span class="mt-5 block font-bold">Read the decision path &rarr;</span>
      </a>
    </div>
  </section>

  <section id="delivery" class="w-full" aria-labelledby="delivery-title">
    <SectionHeader id="delivery-title" title="One run, five visible stages" />
    <Steps
      items={valuationSteps}
      aria-label="Equity valuation lifecycle"
      class="mb-10 w-full"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div>
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Human-readable at the terminal
        </h3>
        <p class="text-lg leading-relaxed text-base-content/70">
          CLI tables make checks, scenarios, and comparisons useful during
          exploration without hiding skipped methods or analytical warnings.
        </p>
      </div>
      <div>
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Structured for the next interface
        </h3>
        <p class="text-lg leading-relaxed text-base-content/70">
          Compact JSON carries metrics, checks, reports, skips, and the summary
          as an integration surface rather than scraping values back out of
          terminal text.
        </p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
      <a
        href="/thejournal/equity_valuation_engine/reading_the_results/"
        class="inline-flex font-bold text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Learn how to read the final output &rarr;
      </a>
      <a
        href="/thejournal/equity_valuation_engine/extending_the_engine/"
        class="inline-flex font-bold text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Follow the extension contracts &rarr;
      </a>
    </div>
  </section>

  <section
    id="outcome"
    class="overflow-hidden rounded-box bg-primary p-8 text-primary-content shadow-xl md:p-12 lg:p-16"
    aria-labelledby="outcome-title"
  >
    <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] opacity-70">
      The outcome
    </p>
    <h2 id="outcome-title" class="max-w-4xl font-display text-3xl font-bold leading-tight sm:text-4xl">
      A valuation run that can be questioned, traced, and compared instead of merely quoted.
    </h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed opacity-80">
      The estimates are analytical tools, not investment advice. Use them to
      inspect assumptions, compare models, and find weaknesses in the input
      data.
    </p>
  </section>
</ProjectLayout>

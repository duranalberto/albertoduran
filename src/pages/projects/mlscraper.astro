---
import Callout from "bloomwright-ui/components/display/Callout.astro";
import Steps from "bloomwright-ui/components/display/Steps.astro";
import MermaidDiagram from "bloomwright-ui/components/render/MermaidDiagram.astro";
import { defineMermaidDiagram } from "bloomwright-ui/mermaid";
import { defineJournalLinks } from "@content/define_journal_links";
import ProjectLayout from "@layouts/ProjectLayout.astro";
import { defineProjectPage } from "@data/project_page";
import { completedSteps, stepMarker } from "@utils/steps";
import ProjectSection from "@components/projects/sections/ProjectSection.astro";
import OutcomeBanner from "@components/projects/sections/OutcomeBanner.astro";
import ArrowLink from "@components/ui/navigation/ArrowLink.astro";
import { githubRepoUrl } from "@data/identity";

const journal = await defineJournalLinks(
  {
    firstPriceWatch: "first_price_watch",
    jobConfiguration: "job_configuration",
    runtimeFlow: "runtime_flow",
    providerBoundaries: "provider_boundaries",
    fetchingAndBackoff: "fetching_and_backoff",
    persistenceAndLifecycle: "persistence_and_lifecycle",
    operationsAndExtension: "operations_and_extension",
  },
  { owner: "MLScraper", vault: "mlscraper" },
);

const project = defineProjectPage("/projects/mlscraper/", {
  eyebrow: "Commerce Automation · Observability",
  description:
    "A missed bargain became a Python service that watches four Mexican stores and sends Telegram alerts that quickly helped me catch deals before they sold out.",
  facts: [
    { label: "Runtime", value: "FastAPI · asyncio" },
    { label: "Config", value: "YAML jobs" },
    { label: "Fetch", value: "HTTP · Playwright" },
    { label: "Alerts", value: "Telegram" },
  ],
  stack: [
    { label: "Python", icon: "python" },
    { label: "FastAPI", icon: "fastapi" },
    { label: "asyncio", icon: "python" },
    { label: "Playwright", icon: "playwright" },
    { label: "YAML", icon: "yaml" },
    { label: "Telegram", icon: "python" },
  ],
  links: {
    githubUrl: githubRepoUrl("MLScraper"),
    journalId: "mlscraper",
  },
});

const readingPath = [
  {
    title: "Follow one watch before opening the internals",
    description:
      "Configure an illustrative Amazon Mexico job, preview its URL, and trace its baseline, later price change, health report, and optional alert.",
    href: journal.firstPriceWatch.href,
  },
  {
    title: "See how YAML becomes a store URL",
    description:
      "Learn which fields define a watch, how provider options build a route, and why previewing the result is safer than discovering a mistake inside the scheduler.",
    href: journal.jobConfiguration.href,
  },
  {
    title: "Follow one scheduled scrape cycle",
    description:
      "See how FastAPI starts the service, provider loops share concurrency, motor failures stay isolated, and health describes the work running in the background.",
    href: journal.runtimeFlow.href,
  },
  {
    title: "Keep store parsing inside adapters",
    description:
      "Compare the four page formats and the small product record that lets shared lifecycle code work without importing store-specific selectors.",
    href: journal.providerBoundaries.href,
  },
];

const stateCapabilities = [
  {
    label: "History",
    title: "A change keeps its previous value",
    description:
      "Price and title updates move the old values into capped history records before the latest observation replaces them.",
  },
  {
    label: "Lifecycle",
    title: "Three complete misses finish a product",
    description:
      "One complete miss moves an active product on hold. The default threshold waits for three complete misses before moving it to finished.",
  },
  {
    label: "Safety",
    title: "Incomplete pages cannot report absences",
    description:
      "A blocked or malformed page stops before missing-item reconciliation, so uncertain input does not rewrite valid product state.",
  },
];

const scrapeSteps = completedSteps([
  "Load job",
  "Fetch pages",
  "Parse items",
  "Reconcile",
  "Report",
]);

const scraperFlow = defineMermaidDiagram(String.raw`
flowchart LR
    Jobs["⚙️ Validated YAML jobs"] --> Registry["🔌 Provider registry"]
    Registry --> Loops["🔄 Independent provider loops"]
    Loops --> Fetch{"🌐 HTTP or browser fetch"}
    Fetch -->|usable page| Parse["📝 Provider-owned parsing"]
    Fetch -->|blocked or failed| Backoff["⏱️ Report and back off"]
    Backoff --> Loops
    Parse --> State["📦 Reconcile product lifecycle"]
    State --> Persist["💾 JSON history"]
    State --> Notify["📨 Optional Telegram alert"]
    Loops --> Health["📊 Operator health endpoint"]

    classDef config fill:#FFE4B5,stroke:#333,stroke-width:2px,color:#000
    classDef process fill:#90EE90,stroke:#333,stroke-width:2px,color:#064E3B
    classDef decision fill:#FFD700,stroke:#333,stroke-width:2px,color:#000
    classDef warning fill:#FFB6C1,stroke:#B91C1C,stroke-width:2px,color:#000
    classDef data fill:#E6E6FA,stroke:#333,stroke-width:2px,color:#1E3A8A
    classDef output fill:#87CEEB,stroke:#333,stroke-width:2px,color:#0F172A

    class Jobs config
    class Registry,Loops,Parse,State process
    class Fetch decision
    class Backoff warning
    class Persist data
    class Notify,Health output
`);
---

<ProjectLayout project={project}>
  <ProjectSection id="overview" title="The bargain I missed">

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-5 lg:col-span-7">
        <p class="text-xl leading-relaxed text-base-content md:text-2xl">
          I saved a deeply discounted product and returned five minutes later
          ready to buy it. It was already sold out. After seeing several more
          bargains disappear just as quickly, I started wondering how many I
          never saw at all.
        </p>
        <p
          class="max-w-3xl text-base leading-relaxed text-base-content/70 md:text-lg"
        >
          That question became MLScraper. It now watches Amazon Mexico, Mercado
          Libre, Liverpool, and Palacio de Hierro, keeps local price history,
          and reports selected drops through Telegram. It worked so well that I
          eventually stopped using it because I was spending money on things I
          did not need.
        </p>
      </div>

      <Callout
        variant="information"
        title="Why it was useful"
        class="lg:col-span-5"
      >
        <p>
          Instead of refreshing the same stores all day, I received a Telegram
          message when MLScraper found a worthwhile discount. That gave me a
          chance to buy before the bargain disappeared.
        </p>
      </Callout>
    </div>
  </ProjectSection>

  <ProjectSection id="runtime" title="Four providers run without sharing one failure state">
    <p class="mb-8 max-w-4xl text-lg leading-relaxed text-base-content/75">
      FastAPI starts the service and exposes health. The scraper groups jobs by
      provider, applies a provider-specific concurrency limit, and schedules
      each group independently. One blocked store does not stop the others.
    </p>
    <MermaidDiagram code={scraperFlow} />
  </ProjectSection>

  <ProjectSection id="reading-path" title="Start with one price watch, then open the service">

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        readingPath.map((chapter, index) => (
          <a
            href={chapter.href}
            aria-label={`Read ${chapter.title}`}
            class="group rounded-box border border-base-300 bg-base-100 p-6 text-base-content shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span
              class="mb-4 block font-mono text-sm font-bold text-primary"
              aria-hidden="true"
            >
              {stepMarker(index)}
            </span>
            <h3 class="mb-3 font-display text-xl font-semibold transition-colors group-hover:text-primary">
              {chapter.title}
            </h3>
            <p class="mb-5 leading-relaxed text-base-content/70">
              {chapter.description}
            </p>
            <span class="text-sm font-bold text-primary">
              Read this chapter &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </ProjectSection>

  <ProjectSection id="resilience" title="Retries and cooldowns solve different failures">

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="mb-5 text-xl leading-relaxed text-base-content">
          A fetcher retries short-lived network failures inside one request. A
          provider loop backs off after a broader cycle failure. Keeping those
          timers separate slows the affected work without freezing other stores.
        </p>
        <p class="leading-relaxed text-base-content/70 md:text-lg">
          Browser mode waits for evidence that a page is usable. A returned HTML
          document may still be a login gate or an empty application shell.
          Recognized block signals appear in health, while incomplete cycles
          stop before reconciliation.
        </p>
        <ArrowLink href={journal.fetchingAndBackoff.href} class="mt-6">
          Follow the fetch and backoff paths
        </ArrowLink>
      </div>
      <Callout
        variant="note"
        title="Read health before editing a parser"
        class="lg:col-span-5"
      >
        <p>
          Queue counts, block reasons, cycle timing, and recent errors narrow
          the problem before a maintainer changes store selectors.
        </p>
      </Callout>
    </div>
  </ProjectSection>

  <ProjectSection id="product-state" title="A listing becomes durable product state">

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        stateCapabilities.map((capability) => (
          <article class="rounded-box border border-base-300 bg-base-200 p-6 text-base-content shadow-sm">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-primary">
              {capability.label}
            </p>
            <h3 class="mb-3 font-display text-xl font-semibold">
              {capability.title}
            </h3>
            <p class="leading-relaxed text-base-content/70">
              {capability.description}
            </p>
          </article>
        ))
      }
    </div>

    <ArrowLink href={journal.persistenceAndLifecycle.href} class="mt-6">
      See how streams preserve product history
    </ArrowLink>
  </ProjectSection>

  <ProjectSection id="operations" title="Health is the first debugging surface">

    <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-box border border-base-300 bg-base-100 p-7 shadow-sm">
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Health built for an operator
        </h3>
        <p class="leading-relaxed text-base-content/70 md:text-lg">
          The readiness surface reports provider status, active and queued jobs,
          block reasons, cycle counts, timing, and recent errors. An operator
          can distinguish a live process from a healthy scrape cycle.
        </p>
      </div>
      <div class="rounded-box border border-base-300 bg-base-100 p-7 shadow-sm">
        <h3 class="mb-4 font-display text-2xl font-semibold text-base-content">
          Alerts begin after the baseline
        </h3>
        <p class="leading-relaxed text-base-content/70 md:text-lg">
          The first successful cycle records products without announcing every
          item as new. Later price drops of at least 14 percent can become
          Telegram messages when notifications are configured.
        </p>
      </div>
    </div>

    <ArrowLink href={journal.operationsAndExtension.href}>
      Operate and extend the service
    </ArrowLink>
  </ProjectSection>

  <ProjectSection id="cycle" title="Every watch follows the same guarded cycle">
    <Steps
      items={scrapeSteps}
      aria-label="MLScraper product tracking cycle"
      class="mb-10 w-full"
    />

    <Callout variant="information" title="Responsible scraping">
      <p>
        Provider concurrency limits, page delays, cooldowns, and explicit
        browser mode reduce unnecessary requests. A new adapter inherits those
        controls when it uses the shared motor and scheduler.
      </p>
    </Callout>
  </ProjectSection>

  <OutcomeBanner title="MLScraper turned a missed bargain into a local price-watching service I could trust day to day.">
    <p class="mt-6 max-w-3xl text-lg leading-relaxed opacity-80">
      It watches four stores, keeps product history, handles blocked pages
      without corrupting state, and sends Telegram alerts only after a real price
      change. The project is still intentionally small. It runs as one process
      and writes local files, but it has the pieces that made it useful:
      provider boundaries, guarded reconciliation, operator health, and alerts
      that arrive before the deal disappears.
    </p>
  </OutcomeBanner>
</ProjectLayout>

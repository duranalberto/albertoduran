---
import JournalGrid from "@components/shared/JournalGrid.astro";
import JournalHero from "@components/thejournal/index/JournalHero.astro";
import { entryManifest } from "@content/processors/thejournal";
import { sitesManifest } from "@data/site_manifest";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";
import image from "@assets/thejournal/stock/10.jpg";
import { isVaultChild } from "@content/entry_kind";
import { formatDuration } from "@utils/format";

const byNewestPubDate = (a: { pubDate: Date }, b: { pubDate: Date }) =>
  b.pubDate.getTime() - a.pubDate.getTime();

const allEntries = Object.values(entryManifest);

// Standalone publications and vault roots first, then vault children.
const topLevel = allEntries
  .filter((entry) => !isVaultChild(entry))
  .sort(byNewestPubDate);

const vaultChildren = allEntries.filter(isVaultChild).sort(byNewestPubDate);

const catalog = [...topLevel, ...vaultChildren];

const publicationCount = catalog.length;
const totalReadMinutes = catalog.reduce(
  (total, entry) => total + entry.readTime,
  0,
);
const totalReadTime = formatDuration(totalReadMinutes);
---

<BaseLayout siteManifest={sitesManifest["/thejournal/"]} image={image}>
  <JournalHero
    slot="hero"
    publicationCount={publicationCount}
    totalReadTime={totalReadTime}
  />

  <FlexShell>
    {
      catalog.length === 0 && (
        <div class="flex justify-center">
          <div class="alert alert-info max-w-md">
            <span>No publications found. Check back later!</span>
          </div>
        </div>
      )
    }
    <JournalGrid catalog={catalog} />
  </FlexShell>
</BaseLayout>

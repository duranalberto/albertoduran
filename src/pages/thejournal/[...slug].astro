---
import Article from "@components/thejournal/article/Article.astro";
import type { SiteManifest } from "@appTypes/navigation";
import OnThisPage from "@components/thejournal/article/OnThisPage.astro";
import OnThisPageContent from "@components/thejournal/article/OnThisPageContent.astro";
import Pagination from "@components/thejournal/article/Pagination.astro";
import PublicationHeader from "@components/thejournal/article/PublicationHeader.astro";
import VaultExplorer from "@components/thejournal/article/VaultExplorer.astro";
import VaultNavContent from "@components/thejournal/article/VaultNavContent.astro";
import CodeBlock from "@components/ui/mdx/CodeBlock.astro";
import HeadingAnchor from "@components/ui/mdx/HeadingAnchor.astro";
import HeadingAnchorH3 from "@components/ui/mdx/HeadingAnchorH3.astro";
import ProseTable from "@components/ui/mdx/ProseTable.astro";
import MermaidDiagramWrapper from "@components/ui/mdx/MermaidDiagramWrapper.astro";
import SVGIcon from "@components/ui/primitive/SVGIcon.astro";
import {
  entryManifest,
  rawEntries,
  vaultsManifest,
} from "@content/processors/thejournal";
import { ui } from "@data/icons";
import BaseLayout from "@layouts/BaseLayout.astro";
import FlexShell from "@layouts/FlexShell.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  return rawEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { post: entry },
  }));
}

const { post } = Astro.props;
const renderResult = await render(post);

const entry = entryManifest[post.id];

if (!entry) {
  return Astro.redirect("/404");
}

const vaultContext = entry.vaultId ? vaultsManifest[entry.vaultId] : undefined;

const vaultIcon = ui.vault;
const otpIcon = ui.onThisPage;

if (!vaultIcon || !otpIcon) {
  throw new Error(
    "Required UI icons (vault/onThisPage) are missing from @data/icons",
  );
}

const components = {
  pre: CodeBlock,
  h2: HeadingAnchor,
  h3: HeadingAnchorH3,
  table: ProseTable,
  div: MermaidDiagramWrapper,
};

const prevEntry = entry.previous
  ? (entryManifest[entry.previous] ?? null)
  : null;
const nextEntry = entry.next ? (entryManifest[entry.next] ?? null) : null;
const hasNavigation = !!(prevEntry || nextEntry);

const headings = renderResult.headings.filter(
  (h) => h.depth > 1 && h.depth <= 3,
);

const SIDEBAR_LEFT_WIDTH = "18rem";
const SIDEBAR_RIGHT_WIDTH = "16rem";

const vaultModalTitleId = "vault-modal-title";
const otpModalTitleId = "otp-modal-title";
const siteManifest: SiteManifest = {
  description: entry.description,
  pageTitle: entry.title,
  label: entry.title,
};

const layoutProps = {
  siteManifest,
  ...(entry.image ? { image: entry.image } : {}),
};
---

<BaseLayout {...layoutProps}>
  <div class="journal-root xl:pb-14">
    <div class="journal-content flex-1">
      <FlexShell
        class="journal-shell xl:flex xl:items-start xl:gap-12 py-4 px-4 lg:pb-8"
        py={0}
      >
        {
          vaultContext && (
            <aside
              class="journal-sidebar sidebar-left hidden xl:block shrink-0"
              transition:name="sidebar-left"
            >
              <div class="journal-sidebar-panel">
                <VaultExplorer
                  vault={vaultContext}
                  currentEntryId={entry.id}
                  expandedWidth={SIDEBAR_LEFT_WIDTH}
                />
              </div>
            </aside>
          )
        }

        <div
          class="journal-main-content w-full flex-1 min-w-0 flex flex-col mt-4"
          transition:name="thejournal-main"
        >
          <PublicationHeader entry={entry} vaultContext={vaultContext} />

          <div class="flex-1 break-words" transition:name="thejournal-article">
            <Article>
              <renderResult.Content components={components} />
            </Article>

            {
              hasNavigation && (
                <div class="mt-14">
                  <Pagination prevEntry={prevEntry} nextEntry={nextEntry} />
                </div>
              )
            }
          </div>

          <nav
            class="dock-wrapper xl:hidden z-30"
            aria-label="Article navigation dock"
            transition:name="thejournal-navigation-mobile"
          >
            <div class="dock-inner">
              <div class="join dock-join">
                {
                  vaultContext && (
                    <button
                      type="button"
                      class="btn btn-ghost join-item dock-btn"
                      aria-label="Open Vault Explorer"
                      onclick="document.getElementById('vault-modal-toggle').checked = true"
                    >
                      <SVGIcon
                        icon={vaultIcon}
                        class="size-5 pointer-events-none"
                        aria-hidden="true"
                      />
                      <span class="dock-btn-label">{vaultIcon.text}</span>
                    </button>
                  )
                }

                <button
                  type="button"
                  class="btn btn-ghost join-item dock-btn"
                  aria-label="Open Table of Contents"
                  onclick="document.getElementById('otp-modal-toggle').checked = true"
                >
                  <SVGIcon
                    icon={otpIcon}
                    class="size-5 pointer-events-none"
                    aria-hidden="true"
                  />
                  <span class="dock-btn-label">{otpIcon.text}</span>
                </button>
              </div>
            </div>
          </nav>
        </div>

        {/* SIDEBAR RIGHT */}
        <aside
          class="journal-sidebar sidebar-right hidden xl:block shrink-0"
          transition:name="sidebar-right"
        >
          <div class="journal-sidebar-panel">
            <OnThisPage
              headings={headings}
              expandedWidth={SIDEBAR_RIGHT_WIDTH}
            />
          </div>
        </aside>
      </FlexShell>
    </div>
  </div>

  <Fragment slot="overlays">
    <input
      type="checkbox"
      id="vault-modal-toggle"
      class="modal-toggle"
      aria-hidden="true"
    />
    <div
      class="modal modal-bottom sm:modal-middle"
      role="dialog"
      aria-modal="true"
      aria-labelledby={vaultModalTitleId}
    >
      <div class="modal-box p-0 flex flex-col max-h-[85dvh] sm:max-w-sm">
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-base-content/10 shrink-0"
        >
          <span
            id={vaultModalTitleId}
            class="text-xs font-bold uppercase tracking-widest text-base-content/60"
          >
            Vault Explorer
          </span>
          <button
            type="button"
            class="btn btn-ghost btn-sm btn-circle"
            aria-label="Close Vault Explorer"
            onclick="document.getElementById('vault-modal-toggle').checked = false"
          >
            ✕
          </button>
        </div>
        <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4">
          {
            vaultContext && (
              <VaultNavContent vault={vaultContext} currentEntryId={entry.id} />
            )
          }
        </div>
      </div>
      <button
        type="button"
        class="modal-backdrop"
        aria-label="Close Vault Explorer"
        onclick="document.getElementById('vault-modal-toggle').checked = false"
      ></button>
    </div>

    <input
      type="checkbox"
      id="otp-modal-toggle"
      class="modal-toggle"
      aria-hidden="true"
    />
    <div
      class="modal modal-bottom sm:modal-middle"
      role="dialog"
      aria-modal="true"
      aria-labelledby={otpModalTitleId}
    >
      <div class="modal-box p-0 flex flex-col max-h-[85dvh] sm:max-w-sm">
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-base-content/10 shrink-0"
        >
          <span
            id={otpModalTitleId}
            class="text-xs font-bold uppercase tracking-widest text-base-content/60"
          >
            On This Page
          </span>
          <button
            type="button"
            class="btn btn-ghost btn-sm btn-circle"
            aria-label="Close Table of Contents"
            onclick="document.getElementById('otp-modal-toggle').checked = false"
          >
            ✕
          </button>
        </div>
        <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4">
          <OnThisPageContent headings={headings} />
        </div>
      </div>
      <button
        type="button"
        class="modal-backdrop"
        aria-label="Close Table of Contents"
        onclick="document.getElementById('otp-modal-toggle').checked = false"
      ></button>
    </div>
  </Fragment>
</BaseLayout>
